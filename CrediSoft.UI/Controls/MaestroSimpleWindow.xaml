<Window x:Class="CrediSoft.UI.Controls.MaestroSimpleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="940" Height="520"
        MinWidth="820" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5">

    <Window.Resources>
        <!-- Colores -->
        <SolidColorBrush x:Key="BrPrimary"  Color="#FF8C00"/>
        <SolidColorBrush x:Key="BrPrimDark" Color="#E07000"/>
        <SolidColorBrush x:Key="BrCard"     Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrBorde"    Color="#E5E7EB"/>
        <SolidColorBrush x:Key="BrLabel"    Color="#6B7280"/>
        <SolidColorBrush x:Key="BrValor"    Color="#111827"/>
        <SolidColorBrush x:Key="BrVerde"    Color="#16A34A"/>
        <SolidColorBrush x:Key="BrRojo"     Color="#DC2626"/>
        <SolidColorBrush x:Key="BrGris"     Color="#6B7280"/>

        <!-- Estilo base de botón -->
        <Style x:Key="BtnBase" TargetType="Button">
            <Setter Property="Height"          Value="34"/>
            <Setter Property="Padding"         Value="16,0"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="0,0,8,0"/>
        </Style>
        <Style x:Key="BtnPrimary"   TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#FF8C00"/>
        </Style>
        <Style x:Key="BtnSuccess"   TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#16A34A"/>
        </Style>
        <Style x:Key="BtnDanger"    TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#DC2626"/>
        </Style>
        <Style x:Key="BtnSecondary" TargetType="Button" BasedOn="{StaticResource BtnBase}">
            <Setter Property="Background" Value="#6B7280"/>
        </Style>

        <!-- Estilo de TextBox -->
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Padding"          Value="8,6"/>
            <Setter Property="FontSize"         Value="13"/>
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#E5E7EB"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Foreground"       Value="#111827"/>
        </Style>

        <!-- Estilo de label -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="#6B7280"/>
            <Setter Property="Margin"       Value="0,0,12,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Estilo del DataGrid -->
        <Style x:Key="CrediGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns"          Value="False"/>
            <Setter Property="IsReadOnly"                   Value="True"/>
            <Setter Property="SelectionMode"                Value="Single"/>
            <Setter Property="GridLinesVisibility"          Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"     Value="#F3F4F6"/>
            <Setter Property="BorderThickness"              Value="0"/>
            <Setter Property="Background"                   Value="White"/>
            <Setter Property="RowBackground"                Value="White"/>
            <Setter Property="AlternatingRowBackground"     Value="#F9FAFB"/>
            <Setter Property="FontSize"                     Value="12"/>
            <Setter Property="RowHeight"                    Value="32"/>
            <Setter Property="ColumnHeaderHeight"           Value="34"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Header del DataGrid naranja -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#FF8C00"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontWeight"   Value="Bold"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Padding"      Value="10,0"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Filas sin borde de foco -->
        <Style TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness"  Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- header naranja -->
            <RowDefinition Height="*"/>    <!-- contenido -->
            <RowDefinition Height="Auto"/> <!-- footer -->
        </Grid.RowDefinitions>

        <!-- ── Header ─────────────────────────────────────────────────── -->
        <Border Grid.Row="0" Background="#FF8C00" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTituloHeader"
                               FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Administración de registros"
                               FontSize="11" Foreground="White" Opacity="0.8" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Búsqueda en el header -->
                <StackPanel x:Name="BuscarHeaderPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Buscar:" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="White" CornerRadius="4"
                            BorderBrush="#CC6600" BorderThickness="2"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBox x:Name="TxtBuscar" Width="180" Padding="8,6"
                                     Background="White" FontSize="12"
                                     Foreground="#111827" BorderThickness="0"
                                     KeyDown="OnBuscarKeyDown"
                                     TextChanged="OnBuscarTextChanged"
                                     VerticalContentAlignment="Center"/>
                            <Button Width="36" Height="34" Background="#E07000"
                                    BorderThickness="0" Cursor="Hand"
                                    Click="OnBuscar" Padding="0">
                                <Path Data="M9.5,3 C6.46,3 4,5.46 4,8.5 C4,11.54 6.46,14 9.5,14 C10.75,14 11.9,13.57 12.83,12.86 L17.5,17.5 L18.5,16.5 L13.86,11.83 C14.57,10.9 15,9.75 15,8.5 C15,5.46 12.54,3 9.5,3 Z M9.5,4.5 C11.71,4.5 13.5,6.29 13.5,8.5 C13.5,10.71 11.71,12.5 9.5,12.5 C7.29,12.5 5.5,10.71 5.5,8.5 C5.5,6.29 7.29,4.5 9.5,4.5 Z"
                                      Fill="White" Stretch="Uniform"
                                      Width="16" Height="16"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Contenido ──────────────────────────────────────────────── -->
        <Grid Grid.Row="1" Margin="12,10,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Panel formulario izquierdo -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="1" CornerRadius="6" Padding="14,12">
                <StackPanel>
                    <!-- Título sección -->
                    <Border Background="#FF8C00" CornerRadius="4"
                            Padding="8,5" Margin="0,0,0,12">
                        <TextBlock Text="DATOS" Foreground="White"
                                   FontWeight="Bold" FontSize="11"/>
                    </Border>

                    <!-- Código -->
                    <TextBlock Text="Código" Style="{StaticResource FieldLabel}"
                               Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtCodigo" Style="{StaticResource FieldInput}"
                             IsReadOnly="True" Margin="0,0,0,10"/>

                    <!-- Nombre -->
                    <TextBlock x:Name="LblNombre" Text="Nombre"
                               Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtNombre" Style="{StaticResource FieldInput}"
                             IsReadOnly="True" Margin="0,0,0,14"/>

                    <!-- Atajos -->
                    <Border Background="#F9FAFB" CornerRadius="4"
                            Padding="8,6" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtAtajos"
                                   Text="Ctrl+N=Nuevo   Ctrl+S=Cerrar   F2=Buscar   F3=Editar   F4=Cancelar   F5=Guardar   F6=Eliminar"
                                   FontSize="9.5" Foreground="#9CA3AF"
                                   TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Grid derecho -->
            <Border x:Name="PanelGridDatos" Grid.Column="2" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                <DataGrid x:Name="GridDatos" Style="{StaticResource CrediGrid}"
                          SelectionChanged="OnGridSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="100"/>
                        <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}"  Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ── Footer botonera ────────────────────────────────────────── -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="0,1,0,0" Padding="12,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnVistaPrevia"   Content="Vista previa"  Style="{StaticResource BtnSecondary}" Width="96"  Click="OnVistaPrevia"/>
                <Button x:Name="BtnImprimir"      Content="Imprimir"      Style="{StaticResource BtnSecondary}" Width="84"  Click="OnImprimir"
                        Background="#1B5E20"/>
                <Button x:Name="BtnImprimirTodo"  Content="Imprimir todo" Style="{StaticResource BtnSecondary}" Width="104" Click="OnImprimirTodo"
                        Background="#6438A0"/>
                <Button x:Name="BtnNuevo"  Content="Nuevo"    Style="{StaticResource BtnPrimary}"   Width="76" Click="OnNuevo"/>
                <Button x:Name="BtnEditar"        Content="Editar"   Style="{StaticResource BtnPrimary}"  Width="76"
                        IsEnabled="False" Click="OnEditar"/>
                <Button x:Name="BtnGuardarSimple" Content="Guardar"  Style="{StaticResource BtnSuccess}"  Width="76"
                        IsEnabled="False" Click="OnGuardarClick"/>
                <Button x:Name="BtnEliminar"      Content="Eliminar" Style="{StaticResource BtnDanger}"   Width="76"
                        IsEnabled="False" Click="OnEliminar"/>
                <Button Content="Cerrar"   Style="{StaticResource BtnSecondary}" Width="76"
                        Margin="0" Click="OnCerrar"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
