<Window x:Class="CrediSoft.UI.Views.Shared.SeleccionarFuncionarioModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Seleccionar Funcionario"
        Width="620" Height="520"
        MinWidth="520" MinHeight="400"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="BtnBlue" TargetType="Button">
            <Setter Property="Background"      Value="#1565C0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD"/>
                    <Setter Property="Foreground" Value="#757575"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnGray" TargetType="Button">
            <Setter Property="Background"      Value="#ECEFF1"/>
            <Setter Property="Foreground"      Value="#37474F"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#B0BEC5"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CFD8DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#1565C0" Padding="16,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                           Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="SELECCIONAR FUNCIONARIO" FontSize="14"
                               FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Buscá por nombre, CI o cargo"
                               FontSize="11" Foreground="#90CAF9"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Barra de búsqueda -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="#CFD8DC" BorderThickness="1" CornerRadius="3"
                        Background="White">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#90A4AE" VerticalAlignment="Center"
                                   Margin="8,0,6,0"/>
                        <TextBox x:Name="TxtBuscar" Grid.Column="1"
                                 Padding="4,6" FontSize="13" BorderThickness="0"
                                 TextChanged="OnBuscarChanged"
                                 KeyDown="OnKeyDown">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Resources>
                                        <VisualBrush x:Key="Hint" TileMode="None" Stretch="None" AlignmentX="Left">
                                            <VisualBrush.Visual>
                                                <TextBlock Text="Nombre, CI, cargo..."
                                                           Foreground="#B0BEC5" FontSize="13"
                                                           Margin="0,0,0,0"/>
                                            </VisualBrush.Visual>
                                        </VisualBrush>
                                    </Style.Resources>
                                    <Style.Triggers>
                                        <Trigger Property="Text" Value="">
                                            <Setter Property="Background" Value="{StaticResource Hint}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
                <!-- Contador -->
                <TextBlock x:Name="TxtContador" Grid.Column="1"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="#78909C" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Pie: botones -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtInfoSeleccion" Grid.Column="0"
                           VerticalAlignment="Center" Foreground="#455A64"
                           FontSize="12" TextTrimming="CharacterEllipsis"/>
                <Button Grid.Column="1" Content="Cancelar" Style="{StaticResource BtnGray}"
                        Click="OnCancelar"/>
                <Button x:Name="BtnSeleccionar" Grid.Column="3"
                        Style="{StaticResource BtnBlue}" IsEnabled="False"
                        Click="OnSeleccionar">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Seleccionar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Lista de funcionarios -->
        <Border Margin="12,10,12,10"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4"
                Background="White">
            <ListBox x:Name="ListFuncionarios"
                     BorderThickness="0"
                     SelectionChanged="OnSelectionChanged"
                     MouseDoubleClick="OnDobleClick"
                     KeyDown="OnKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding"  Value="0"/>
                        <Setter Property="Cursor"   Value="Hand"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F5F5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,10" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Avatar con inicial -->
                                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                        Background="#1565C0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Inicial}"
                                               Foreground="White" FontWeight="Bold" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <!-- Nombre + CI -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,10,0">
                                    <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"
                                               FontSize="13" Foreground="#212121"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="CI: " FontSize="11" Foreground="#78909C"/>
                                        <TextBlock Text="{Binding Ci}" FontSize="11" Foreground="#546E7A"/>
                                        <TextBlock Text=" · " FontSize="11" Foreground="#B0BEC5"/>
                                        <TextBlock Text="{Binding Cargo}" FontSize="11" Foreground="#546E7A"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Local badge -->
                                <Border Grid.Column="2" Background="#E8F5E9" CornerRadius="3"
                                        Padding="8,4" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="11" Foreground="#2E7D32"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding NombreLocal}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="#2E7D32"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- Salario -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" MinWidth="100">
                                    <TextBlock Text="SALARIO" FontSize="9" Foreground="#90A4AE"
                                               HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding SalarioFmt}" FontSize="12"
                                               FontWeight="SemiBold" Foreground="#37474F"
                                               HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

    </DockPanel>
</Window>
