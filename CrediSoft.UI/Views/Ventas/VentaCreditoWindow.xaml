                                    <TextBox x:Name="CboCuotas" Style="{StaticResource ChipValueEdit}"
                                             Text="6" IsEnabled="False" TextAlignment="Center"
                                             TextChanged="OnCuotasChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="11">
                                    <TextBlock Style="{StaticResource ChipLabel}" Text="COSTO MENS."/>
                                    <TextBox x:Name="TxtCostoMensual" Style="{StaticResource ChipValue}"
                                             Background="{StaticResource BrC4}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="13">
                                    <TextBlock Style="{StaticResource ChipLabel}" Text="VALOR FINAL"/>
                                    <TextBox x:Name="TxtValorFinal" Style="{StaticResource ChipValue}"
                                             Background="{StaticResource BrC4}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="15">
                                    <TextBlock x:Name="LblCantidad" Style="{StaticResource ChipLabel}" Text="CANT."/>
                                    <TextBox x:Name="TxtCantidad" Style="{StaticResource ChipValueEdit}"
                                             Text="1" TextAlignment="Center"
                                             TextChanged="OnCantidadChanged"/>
                                </StackPanel>
                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="17" x:Name="BtnIngresarArticulo"
                                        Content="▶ Ingresar"
                                        Style="{StaticResource BtnSuccess}"
                                        VerticalAlignment="Bottom"
                                        Click="OnAgregarArticulo"/>

                                <!-- Fila 2: % Descuento / % Recargo — reflejan el plan de pagos
                                     configurado en el modal "Seleccionar Artículo" (o se cargan
                                     a mano acá). Afectan el precio real de venta de la línea
                                     (Costo Mens./Valor Final), no solo una simulación visual. -->
                                <StackPanel Grid.Row="1" Grid.Column="5" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource ChipLabel}" Text="% DESCUENTO"/>
                                    <TextBox x:Name="TxtPctDescuentoArticulo" Style="{StaticResource ChipValueEdit}"
                                             Text="0" IsEnabled="False" TextAlignment="Center"
                                             TextChanged="OnArticuloCalcular"/>
                                </StackPanel>
                                <StackPanel Grid.Row="1" Grid.Column="7" Margin="0,6,0,0">
                                    <TextBlock Style="{StaticResource ChipLabel}" Text="% RECARGO"/>
                                    <TextBox x:Name="TxtPctRecargoArticulo" Style="{StaticResource ChipValueEdit}"
                                             Text="0" IsEnabled="False" TextAlignment="Center"
                                             TextChanged="OnArticuloCalcular" LostFocus="OnPctRecargoLostFocus"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Grilla -->
                        <DataGrid x:Name="GridDetalle" Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserReorderColumns="False"
                                  SelectionMode="Single"
                                  GridLinesVisibility="None"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  BorderThickness="0"
                                  Background="White"
                                  RowBackground="White"
                                  AlternatingRowBackground="{StaticResource BrC4}"
                                  RowHeight="32" FontSize="11"
                                  RowDetailsVisibilityMode="Collapsed"
                                  EnableRowVirtualization="True"
                                  MouseDoubleClick="OnGridDetalleDoubleClick"
                                  PreviewKeyDown="OnGridDetalleKeyDown">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                 Color="#1F77B4"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"
                                                 Color="White"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"
                                                 Color="#D2EBFC"/>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush"     Value="{StaticResource BrCB}"/>
                                    <Setter Property="Margin"          Value="0"/>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background"      Value="{StaticResource BrC1}"/>
                                    <Setter Property="Foreground"      Value="White"/>
                                    <Setter Property="FontWeight"      Value="SemiBold"/>
                                    <Setter Property="FontSize"        Value="11"/>
                                    <Setter Property="Padding"         Value="10,7"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,0"/>
                                    <Setter Property="BorderBrush"     Value="#1A6090"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderThickness="0" Padding="8,0">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código"      Binding="{Binding ArticuloCodigo}"                Width="65"  ElementStyle="{StaticResource CeldaGrid}"/>
                                <DataGridTextColumn Header="Descripción" Binding="{Binding ArticuloNombre}"                Width="*"   ElementStyle="{StaticResource CeldaGrid}"/>
                                <DataGridTextColumn Header="Precio"      Binding="{Binding Pv, StringFormat=N0}"           Width="82"  ElementStyle="{StaticResource CeldaGridDer}"/>
                                <DataGridTextColumn Header="Entrega"     Binding="{Binding EntregaLinea, StringFormat=N0}" Width="68"  ElementStyle="{StaticResource CeldaGridDer}"/>
                                <DataGridTextColumn Header="Cuotas"      Binding="{Binding CuotasLinea}"                   Width="52"  ElementStyle="{StaticResource CeldaGridCen}"/>
                                <DataGridTextColumn Header="Costo mens." Binding="{Binding CostoMensual, StringFormat=N0}" Width="84"  ElementStyle="{StaticResource CeldaGridDer}"/>
                                <DataGridTextColumn Header="Total final" Binding="{Binding ValorFinal, StringFormat=N0}"   Width="84"  ElementStyle="{StaticResource CeldaGridDer}"/>
                                <DataGridTextColumn Header="Cant."       Binding="{Binding Cantidad, StringFormat=N0}"     Width="46"  ElementStyle="{StaticResource CeldaGridCen}"/>
                                <DataGridTextColumn Header="Subtotal"    Binding="{Binding Subtotal, StringFormat=N0}"     Width="88"  ElementStyle="{StaticResource CeldaGridDer}"/>
                                <DataGridTemplateColumn Header="" Width="40" CanUserResize="False" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Width="26" Height="22" Padding="0"
                                                    BorderThickness="0"
                                                    Background="{StaticResource BrC5}"
                                                    Foreground="White" Cursor="Hand"
                                                    Click="OnEliminarFila">
                                                <TextBlock Text="✕" FontSize="11" FontWeight="Bold"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Total -->
                        <Border Grid.Row="2" Background="{StaticResource BrC1}"
                                CornerRadius="0,0,9,9" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOTAL GENERAL" FontSize="10" FontWeight="Bold"
                                           Foreground="#80AACC" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="Gs." FontSize="14" FontWeight="Bold"
                                               Foreground="#80AACC" VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <TextBox x:Name="TxtTotal" Width="150"
                                             IsReadOnly="True" FontSize="20" FontWeight="Bold"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="White" TextAlignment="Right"
                                             VerticalContentAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

            </TabControl>
        </Grid>

        <!-- ════════════════════════════════════════════════════════
             FOOTER
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2" Background="{StaticResource BrC1}" Padding="12,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>   <!-- izquierda: vacío o info -->
                    <ColumnDefinition Width="Auto"/> <!-- centro: navegación      -->
                    <ColumnDefinition Width="*"/>   <!-- derecha: botones acción  -->
                </Grid.ColumnDefinitions>

                <!-- ── Centro: navegación ── -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Center">

                    <Button x:Name="BtnAnterior"
                            Content="← Anterior"
                            Width="104" Height="36" Margin="0,0,8,0"
                            Background="#1A3A52" Foreground="White"
                            FontWeight="SemiBold" FontSize="12" BorderThickness="0"
                            Cursor="Hand" Click="OnTabAnterior"/>

                    <!-- Dots + label -->
                    <Border Background="#0E2A40" CornerRadius="18"
                            Padding="14,0" Height="36" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="Dot0" Width="9" Height="9" Margin="3,0" Fill="White"/>
                            <Ellipse x:Name="Dot1" Width="9" Height="9" Margin="3,0" Fill="#3A5A72"/>
                            <Ellipse x:Name="Dot2" Width="9" Height="9" Margin="3,0" Fill="#3A5A72"/>
                            <Ellipse x:Name="Dot3" Width="9" Height="9" Margin="3,0" Fill="#3A5A72"/>
                            <TextBlock x:Name="TxtPasoLabel"
                                       Text="Paso 1 de 4"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#80AACC"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button x:Name="BtnSiguiente"
                            Content="Siguiente →"
                            Width="114" Height="36" Margin="8,0,0,0"
                            Background="{StaticResource BrC2}" Foreground="White"
                            FontWeight="SemiBold" FontSize="12" BorderThickness="0"
                            Cursor="Hand" Click="OnTabSiguiente"/>
                </StackPanel>

                <!-- ── Derecha: botones de acción ── -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnNuevo" Content="Nuevo"
                            Width="80" Height="34" Margin="4,0"
                            Background="#2C5F8A" Foreground="White"
                            FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                            Cursor="Hand" Click="OnNuevo"/>
                    <Button x:Name="BtnGuardar" Content="💾 Guardar"
                            Width="96" Height="34" Margin="4,0"
                            Background="#1E6E42" Foreground="White"
                            FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                            Cursor="Hand" Click="OnConfirmarVenta"/>
                    <Button x:Name="BtnEliminar" Content="🗑 Eliminar"
                            Width="96" Height="34" Margin="4,0"
                            Background="{StaticResource BrC5}" Foreground="White"
                            FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                            Cursor="Hand" Click="OnEliminar"/>
                    <Button x:Name="BtnCerrar" Content="✕ Cerrar"
                            Width="80" Height="34" Margin="4,0,0,0"
                            Background="#3E4A5A" Foreground="White"
                            FontWeight="SemiBold" FontSize="11" BorderThickness="0"
                            Cursor="Hand" Click="OnCancelar"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
