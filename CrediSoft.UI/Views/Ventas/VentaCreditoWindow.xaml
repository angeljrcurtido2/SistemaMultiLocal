                                               FontWeight="Bold" Foreground="{StaticResource BrCS}"
                                               Margin="0,0,0,10"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource ChipLabel}" Text="NOMBRE"/>
                                            <TextBox x:Name="TxtRefC1Nom" Style="{StaticResource ChipValueEdit}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource ChipLabel}" Text="TELÉFONO"/>
                                            <TextBox x:Name="TxtRefC1Tel" Style="{StaticResource ChipValueEdit}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
