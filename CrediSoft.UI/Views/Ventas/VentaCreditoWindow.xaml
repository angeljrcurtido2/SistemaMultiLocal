                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource ChipLabel}" Text="CIUDAD"/>
                                    <TextBox x:Name="TxtClienteCiudad" Style="{StaticResource ChipValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
