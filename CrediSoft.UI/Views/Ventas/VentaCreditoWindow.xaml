<Window x:Class="CrediSoft.UI.Views.Ventas.VentaCreditoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solicitud / Venta a Crédito"
        Width="1380" Height="760"
        MinWidth="1200" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#FFA500"
        KeyDown="OnWindowKeyDown">

    <Grid Margin="4">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ══ CUERPO PRINCIPAL ══ -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <!-- Columna izquierda: Solicitud + Ingresos/Egresos -->
                <ColumnDefinition Width="230" />
                <!-- Columna derecha: Cliente + Garante + Referencias + Mercaderías -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══════════════════════════════════
                 COLUMNA IZQUIERDA
                 ══════════════════════════════════ -->
            <StackPanel Grid.Column="0" Margin="0,0,4,0">

                <!-- SOLICITUD -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="4,4,4,6" Margin="0,0,0,4" Background="#FFF0C0">
                    <StackPanel>
                        <TextBlock Text="SOLICITUD" FontWeight="Bold" FontSize="11" Margin="0,0,0,4" />

                        <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nº" VerticalAlignment="Center" Margin="0,0,4,0" FontSize="11" />
                            <TextBox x:Name="TxtNroSolicitud" Grid.Column="1" IsReadOnly="True"
                                     Background="#FFFF99" Padding="2,1" FontSize="11" />
                            <Button x:Name="BtnBuscarSolicitud" Grid.Column="2" Content="Buscar"
                                    Margin="2,0,0,0" Padding="5,2" FontSize="10"
                                    Background="#CC0000" Foreground="White" FontWeight="Bold"
                                    Click="OnBuscarSolicitud" />
                        </Grid>

                        <TextBlock Text="Número:" FontSize="10" Margin="0,2,0,1" />
                        <TextBox x:Name="TxtNumero" Padding="2,1" FontSize="11" Background="#FFFF99" />

                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" x:Name="BtnLocal" Content="Local"
                                    Padding="5,2" FontSize="10"
                                    Background="#CC0000" Foreground="White" FontWeight="Bold"
                                    Click="OnSeleccionarLocal" />
                            <TextBox x:Name="TxtLocal" Grid.Column="1" Margin="3,0,0,0"
                                     IsReadOnly="True" Padding="2,1" FontSize="11" Background="#FFFF99" />
                        </Grid>

                        <TextBox x:Name="TxtLocalNombre" Padding="2,1" FontSize="10"
                                 IsReadOnly="True" Background="#F5F5F5" Margin="0,2,0,0" />

                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vendedor:" VerticalAlignment="Center"
                                       Margin="0,0,4,0" FontSize="10" />
                            <Button Grid.Column="1" x:Name="BtnBuscarVendedor" Content="Buscar"
                                    Padding="5,2" FontSize="10"
                                    Background="#006600" Foreground="White" FontWeight="Bold"
                                    HorizontalAlignment="Left"
                                    Click="OnBuscarVendedor" />
                        </Grid>
                        <TextBox x:Name="TxtVendedor" Padding="2,1" FontSize="11"
                                 IsReadOnly="True" Background="#FFFF99" Margin="0,2,0,0" />

                        <TextBlock Text="Solicitud:" FontSize="10" Margin="0,3,0,1" />
                        <DatePicker x:Name="DtpSolicitud" FontSize="10" />

                        <TextBlock Text="Figurar:" FontSize="10" Margin="0,3,0,1" />
                        <DatePicker x:Name="DtpFigurar" FontSize="10" />

                        <Border Background="#FFFFFF" BorderBrush="Gray" BorderThickness="1"
                                Margin="0,6,0,0" Height="32">
                            <TextBlock x:Name="TxtEstado" Text="ESTADO"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontWeight="Bold" FontSize="13" />
                        </Border>

                        <Border Background="#FFA500" Margin="0,3,0,0" Height="20" />
                    </StackPanel>
                </Border>

                <!-- INGRESOS / EGRESOS -->
                <Border BorderBrush="Gray" BorderThickness="1" Padding="4" Background="#FFF0C0">
                    <StackPanel>
                        <!-- Encabezado tabla IE -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Grid.ColumnSpan="2" Background="#6666CC" Margin="0,0,2,0">
                                <TextBlock Text="INGRESOS" Foreground="White" FontWeight="Bold"
                                           FontSize="10" HorizontalAlignment="Center" Padding="2" />
                            </Border>
                            <Border Grid.Column="2" Grid.ColumnSpan="2" Background="#6666CC" Margin="2,0,0,0">
                                <TextBlock Text="EGRESOS" Foreground="White" FontWeight="Bold"
                                           FontSize="10" HorizontalAlignment="Center" Padding="2" />
                            </Border>
                        </Grid>

                        <!-- Filas IE -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="70" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Salario" FontSize="10" VerticalAlignment="Center" Padding="2,0" />
                            <TextBox x:Name="TxtISalario" Grid.Row="0" Grid.Column="1" Padding="2,1" FontSize="10" Background="#FFFF99" Text="0" TextChanged="OnIngresoEgresoChanged" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Gastos familiares" FontSize="10" VerticalAlignment="Center" Padding="2,0" />
                            <TextBox x:Name="TxtEGasto" Grid.Row="0" Grid.Column="3" Padding="2,1" FontSize="10" Background="#FFFF99" Text="0" TextChanged="OnIngresoEgresoChanged" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Honorario Prof." FontSize="10" VerticalAlignment="Center" Padding="2,0" />
                            <TextBox x:Name="TxtIHonorario" Grid.Row="1" Grid.Column="1" Padding="2,1" FontSize="10" Background="#FFFF99" Text="0" TextChanged="OnIngresoEgresoChanged" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Cuotas" FontSize="10" VerticalAlignment="Center" Padding="2,0" />
                            <TextBox x:Name="TxtECuota" Grid.Row="1" Grid.Column="3" Padding="2,1" FontSize="10" Background="#FFFF99" Text="0" TextChanged="OnIngresoEgresoChanged" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Salario Cónyuge" FontSize="10" VerticalAlignment="Center" Padding="2,0" />
                            <TextBox x:Name="TxtIConyuge" Grid.Row="2" Grid.Column="1" Padding="2,1" FontSize="10" Background="#FFFF99" Text="0" TextChanged="OnIngresoEgresoChanged" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Alquiler" FontSize="10" VerticalAlignment="Center" Padding="2,0" />
                            <TextBox x:Name="TxtEAlquiler" Grid.Row="2" Grid.Column="3" Padding="2,1" FontSize="10" Background="#FFFF99" Text="0" TextChanged="OnIngresoEgresoChanged" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Otros" FontSize="10" VerticalAlignment="Center" Padding="2,0" />
                            <TextBox x:Name="TxtIOtros" Grid.Row="3" Grid.Column="1" Padding="2,1" FontSize="10" Background="#FFFF99" Text="0" TextChanged="OnIngresoEgresoChanged" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Otros" FontSize="10" VerticalAlignment="Center" Padding="2,0" />
                            <TextBox x:Name="TxtEOtros" Grid.Row="3" Grid.Column="3" Padding="2,1" FontSize="10" Background="#FFFF99" Text="0" TextChanged="OnIngresoEgresoChanged" />

                            <!-- TOTALES -->
                            <Border Grid.Row="4" Grid.Column="0" Background="#6666CC">
                                <TextBlock Text="TOTAL" Foreground="#00FF00" FontWeight="Bold"
                                           FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox x:Name="TxtITotal" Grid.Row="4" Grid.Column="1" Padding="2,1" FontSize="10"
                                     IsReadOnly="True" Background="#CCFFCC" FontWeight="Bold" />
                            <Border Grid.Row="4" Grid.Column="2" Background="#6666CC">
                                <TextBlock Text="TOTAL" Foreground="#FF4444" FontWeight="Bold"
                                           FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBox x:Name="TxtETotal" Grid.Row="4" Grid.Column="3" Padding="2,1" FontSize="10"
                                     IsReadOnly="True" Background="#FFCCCC" FontWeight="Bold" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ══════════════════════════════════
                 COLUMNA DERECHA
                 ══════════════════════════════════ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <!-- Cliente -->
                    <RowDefinition Height="Auto" />
                    <!-- Garante -->
                    <RowDefinition Height="Auto" />
                    <!-- Referencias -->
                    <RowDefinition Height="Auto" />
                    <!-- Mercaderías -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ── CLIENTE ── -->
                <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1"
                        Padding="4,4,4,6" Margin="0,0,0,3" Background="#FFF0C0">
                    <StackPanel>
                        <TextBlock Text="Cliente" FontWeight="Bold" FontSize="11" Margin="0,0,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="60" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                            </Grid.RowDefinitions>

                            <!-- Fila 0 -->
                            <Button Grid.Row="0" Grid.Column="0" x:Name="BtnBuscarCliente"
                                    Content="Cliente" Padding="6,2" FontSize="10"
                                    Background="#CC0000" Foreground="White" FontWeight="Bold"
                                    Click="OnBuscarCliente" />
                            <TextBox x:Name="TxtClienteNombre" Grid.Row="0" Grid.Column="1"
                                     Margin="2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="C.I.:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteCI" Grid.Row="0" Grid.Column="3"
                                     Margin="2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="RUC:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteRUC" Grid.Row="0" Grid.Column="5"
                                     Margin="2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Dirección:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteDireccion" Grid.Row="0" Grid.Column="7"
                                     Margin="2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="0" Grid.Column="8" Text="Sexo:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteSexo" Grid.Row="0" Grid.Column="9"
                                     Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />

                            <!-- Fila 1 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Celular:" VerticalAlignment="Center" Margin="0,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteCelular" Grid.Row="1" Grid.Column="1"
                                     Margin="2,2,2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="Ciudad:" VerticalAlignment="Center" Margin="4,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteCiudad" Grid.Row="1" Grid.Column="3"
                                     Margin="2,2,2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Estado:" VerticalAlignment="Center" Margin="4,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteEstado" Grid.Row="1" Grid.Column="5"
                                     Margin="2,2,2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="1" Grid.Column="6" Text="Estado Civil:" VerticalAlignment="Center" Margin="4,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteECV" Grid.Row="1" Grid.Column="7"
                                     Margin="2,2,2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="1" Grid.Column="8" Text="Informconf:" VerticalAlignment="Center" Margin="4,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteInformconf" Grid.Row="1" Grid.Column="9"
                                     Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />

                            <!-- Fila 2 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Lugar de trabajo:" VerticalAlignment="Center" Margin="0,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteLugarTrabajo" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                                     Margin="2,2,2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="2" Grid.Column="4" Text="Teléfono laboral:" VerticalAlignment="Center" Margin="4,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteTelLab" Grid.Row="2" Grid.Column="5"
                                     Margin="2,2,2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="2" Grid.Column="6" Text="Condición:" VerticalAlignment="Center" Margin="4,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteCondicion" Grid.Row="2" Grid.Column="7"
                                     Margin="2,2,2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="2" Grid.Column="8" Text="Tipo:" VerticalAlignment="Center" Margin="4,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteTipo" Grid.Row="2" Grid.Column="9"
                                     Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                        </Grid>

                        <!-- Fila extra: Antigüedad, Crédito máx, Saldo, Cónyuge, Venc CI, botones -->
                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Antigüedad:" VerticalAlignment="Center" Margin="0,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteAntiguedad" Grid.Column="1" Padding="2,1" FontSize="10" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Column="2" Text="Crédito máximo:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteCredMax" Grid.Column="3" Padding="2,1" FontSize="10" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Column="4" Text="Saldo actual:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteSaldo" Grid.Column="5" Padding="2,1" FontSize="10" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Column="6" Text="Cónyuge:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteConyuge" Grid.Column="7" Padding="2,1" FontSize="10" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Column="8" Text="Vencimiento C.I.:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtClienteVencCI" Grid.Column="9" Padding="2,1" FontSize="10" IsReadOnly="True" Background="#FFFF99" />
                            <Button Grid.Column="10" Content="Historial" Margin="4,0,2,0" Padding="6,2" FontSize="10"
                                    Background="#CC6600" Foreground="White" FontWeight="Bold"
                                    Click="OnVerHistorialCliente" />
                            <Button Grid.Column="11" Content="Ver cédula" Padding="6,2" FontSize="10"
                                    Background="#CC6600" Foreground="White" FontWeight="Bold"
                                    Click="OnVerCedulaCliente" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── GARANTE ── -->
                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                        Padding="4,4,4,6" Margin="0,0,0,3" Background="#FFF0C0">
                    <StackPanel>
                        <TextBlock Text="Garante" FontWeight="Bold" FontSize="11" Margin="0,0,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="22" />
                                <RowDefinition Height="22" />
                            </Grid.RowDefinitions>

                            <!-- Fila 0 -->
                            <Button Grid.Row="0" Grid.Column="0" x:Name="BtnBuscarGarante"
                                    Content="Garante" Padding="6,2" FontSize="10"
                                    Background="#CC0000" Foreground="White" FontWeight="Bold"
                                    Click="OnBuscarGarante" />
                            <TextBox x:Name="TxtGaranteNombre" Grid.Row="0" Grid.Column="1"
                                     Margin="2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="C.I.:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtGaranteCI" Grid.Row="0" Grid.Column="3"
                                     Margin="2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="0" Grid.Column="4" Text="Dirección:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtGaranteDireccion" Grid.Row="0" Grid.Column="5"
                                     Margin="2,0" Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Teléfono:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtGaranteTelefono" Grid.Row="0" Grid.Column="7"
                                     Padding="2,1" FontSize="11" IsReadOnly="True" Background="#FFFF99" />

                            <!-- Fila 1 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Lugar de trabajo:" VerticalAlignment="Center" Margin="0,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtGaranteLugarTrabajo" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                                     Margin="2,2,2,0" Padding="2,1" FontSize="10" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="1" Grid.Column="4" Text="Teléfono laboral:" VerticalAlignment="Center" Margin="4,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtGaranteTelLab" Grid.Row="1" Grid.Column="5"
                                     Margin="2,2,2,0" Padding="2,1" FontSize="10" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Row="1" Grid.Column="6" Text="Antigüedad:" VerticalAlignment="Center" Margin="4,2,2,0" FontSize="10" />
                            <TextBox x:Name="TxtGaranteAntiguedad" Grid.Row="1" Grid.Column="7"
                                     Padding="2,1" FontSize="10" IsReadOnly="True" Background="#FFFF99" />
                        </Grid>

                        <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Vencimiento C.I.:" VerticalAlignment="Center" Margin="0,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtGaranteVencCI" Grid.Column="1" Padding="2,1" FontSize="10" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Column="2" Text="Estado Civil:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtGaranteECV" Grid.Column="3" Padding="2,1" FontSize="10" IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Column="4" Text="Cónyuge:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtGaranteConyuge" Grid.Column="5" Padding="2,1" FontSize="10" IsReadOnly="True" Background="#FFFF99" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── REFERENCIAS ── -->
                <Border Grid.Row="2" BorderBrush="Gray" BorderThickness="1"
                        Padding="4" Margin="0,0,0,3" Background="#FFF0C0">
                    <StackPanel>
                        <TextBlock Text="Referencias" FontWeight="Bold" FontSize="11" Margin="0,0,0,3" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Ref 1: botón | nombre | celular | trabajo -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <!-- separador -->
                                <ColumnDefinition Width="8" />
                                <!-- Ref 2: botón | nombre | celular | trabajo -->
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="24" />
                                <RowDefinition Height="4" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="24" />
                            </Grid.RowDefinitions>

                            <!-- ── Encabezados Ref personal ── -->
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="Ref. personal 1" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,1" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Celular"          FontSize="9" FontWeight="SemiBold" Margin="2,0,0,1" />
                            <TextBlock Grid.Row="0" Grid.Column="3" Text="Lugar de trabajo" FontSize="9" FontWeight="SemiBold" Margin="2,0,0,1" />
                            <TextBlock Grid.Row="0" Grid.Column="6" Text="Ref. personal 2"  FontSize="9" FontWeight="SemiBold" Margin="2,0,0,1" />
                            <TextBlock Grid.Row="0" Grid.Column="7" Text="Celular"           FontSize="9" FontWeight="SemiBold" Margin="2,0,0,1" />
                            <TextBlock Grid.Row="0" Grid.Column="8" Text="Lugar de trabajo"  FontSize="9" FontWeight="SemiBold" Margin="2,0,0,1" />

                            <!-- ── Botón + campos Ref personal 1 ── -->
                            <Button x:Name="BtnBuscarRef1" Grid.Row="1" Grid.Column="0"
                                    Content="Buscar" Padding="5,1" FontSize="9" Margin="0,0,3,0"
                                    Background="#CC0000" Foreground="White" FontWeight="Bold"
                                    Click="OnBuscarRef1" />
                            <TextBox x:Name="TxtRef1Nom"  Grid.Row="1" Grid.Column="1" Padding="2,1" FontSize="10" Background="White" />
                            <TextBox x:Name="TxtRef1Tel"  Grid.Row="1" Grid.Column="2" Margin="2,0" Padding="2,1" FontSize="10" Background="White" />
                            <TextBox x:Name="TxtRef1Trab" Grid.Row="1" Grid.Column="3" Padding="2,1" FontSize="10" Background="White" />

                            <!-- ── Botón + campos Ref personal 2 ── -->
                            <Button x:Name="BtnBuscarRef2" Grid.Row="1" Grid.Column="5"
                                    Content="Buscar" Padding="5,1" FontSize="9" Margin="2,0,3,0"
                                    Background="#CC0000" Foreground="White" FontWeight="Bold"
                                    Click="OnBuscarRef2" />
                            <TextBox x:Name="TxtRef2Nom"  Grid.Row="1" Grid.Column="6" Padding="2,1" FontSize="10" Background="White" />
                            <TextBox x:Name="TxtRef2Tel"  Grid.Row="1" Grid.Column="7" Margin="2,0" Padding="2,1" FontSize="10" Background="White" />
                            <TextBox x:Name="TxtRef2Trab" Grid.Row="1" Grid.Column="8" Padding="2,1" FontSize="10" Background="White" />

                            <!-- ── Encabezados Ref comercial ── -->
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="Ref. comercial 1" FontSize="9" FontWeight="SemiBold" Foreground="#555" Margin="2,0,0,1" />
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Teléfono"          FontSize="9" FontWeight="SemiBold" Foreground="#555" Margin="2,0,0,1" />
                            <TextBlock Grid.Row="3" Grid.Column="6" Text="Ref. comercial 2"  FontSize="9" FontWeight="SemiBold" Foreground="#555" Margin="2,0,0,1" />
                            <TextBlock Grid.Row="3" Grid.Column="7" Text="Teléfono"           FontSize="9" FontWeight="SemiBold" Foreground="#555" Margin="2,0,0,1" />

                            <!-- ── Campos Ref comercial (solo texto) ── -->
                            <TextBox x:Name="TxtRefC1Nom" Grid.Row="4" Grid.Column="1" Padding="2,1" FontSize="10" Background="White" />
                            <TextBox x:Name="TxtRefC1Tel" Grid.Row="4" Grid.Column="2" Margin="2,0" Padding="2,1" FontSize="10" Background="White" />
                            <TextBox x:Name="TxtRefC2Nom" Grid.Row="4" Grid.Column="6" Padding="2,1" FontSize="10" Background="White" />
                            <TextBox x:Name="TxtRefC2Tel" Grid.Row="4" Grid.Column="7" Margin="2,0" Padding="2,1" FontSize="10" Background="White" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── MERCADERÍAS ── -->
                <Border Grid.Row="3" BorderBrush="Gray" BorderThickness="1"
                        Padding="4" Background="#FFF0C0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Mercaderías" FontWeight="Bold" FontSize="11" Margin="0,0,0,3" />

                        <!-- Barra de ingreso artículo -->
                        <Grid Grid.Row="1" Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="55" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Código" Padding="5,2" FontSize="10"
                                    Background="#CC0000" Foreground="White" FontWeight="Bold"
                                    Click="OnBuscarArticulo" />
                            <TextBox x:Name="TxtCodigoArticulo" Grid.Column="1" Margin="2,0" Padding="2,1" FontSize="10"
                                     KeyDown="OnCodigoArticuloKeyDown" />
                            <TextBlock Grid.Column="2" Text="Descripción:" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtDescArticulo" Grid.Column="3" Margin="2,0" Padding="2,1" FontSize="10"
                                     IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Column="4" Text="Precio" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtPrecioArticulo" Grid.Column="5" Margin="2,0" Padding="2,1" FontSize="10" Background="White" TextChanged="OnArticuloCalcular" />
                            <TextBlock Grid.Column="6" Text="Entrega" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtEntregaArticulo" Grid.Column="7" Margin="2,0" Padding="2,1" FontSize="10" Background="White" Text="0" TextChanged="OnArticuloCalcular" />
                            <TextBlock Grid.Column="8" Text="Cuotas" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <ComboBox x:Name="CboCuotas" Grid.Column="9" Margin="2,0" Padding="2,1" FontSize="10"
                                      SelectionChanged="OnCuotasChanged">
                                <ComboBoxItem Content="3"  Tag="3"  />
                                <ComboBoxItem Content="6"  Tag="6"  IsSelected="True" />
                                <ComboBoxItem Content="9"  Tag="9"  />
                                <ComboBoxItem Content="12" Tag="12" />
                                <ComboBoxItem Content="18" Tag="18" />
                                <ComboBoxItem Content="24" Tag="24" />
                                <ComboBoxItem Content="36" Tag="36" />
                            </ComboBox>
                            <TextBlock Grid.Column="10" Text="Costo mensual" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtCostoMensual" Grid.Column="11" Margin="2,0" Padding="2,1" FontSize="10"
                                     IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Column="12" Text="Valor final" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtValorFinal" Grid.Column="13" Margin="2,0" Padding="2,1" FontSize="10"
                                     IsReadOnly="True" Background="#FFFF99" />
                            <TextBlock Grid.Column="14" Text="Cantidad" VerticalAlignment="Center" Margin="4,0,2,0" FontSize="10" />
                            <TextBox x:Name="TxtCantidad" Grid.Column="15" Margin="2,0" Padding="2,1" FontSize="10" Text="1" />
                            <Button Grid.Column="16" Content="▶ Ingresar" Margin="4,0,0,0" Padding="6,2" FontSize="10"
                                    Background="#006600" Foreground="White" FontWeight="Bold"
                                    Click="OnAgregarArticulo" />
                        </Grid>

                        <!-- Grilla de artículos -->
                        <DataGrid x:Name="GridDetalle" Grid.Row="2"
                                  Style="{StaticResource CrediGrid}"
                                  Background="LightYellow"
                                  MouseDoubleClick="OnGridDetalleDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código"       Binding="{Binding ArticuloCodigo}"             Width="70" />
                                <DataGridTextColumn Header="Descripción"  Binding="{Binding ArticuloNombre}"             Width="*" />
                                <DataGridTextColumn Header="Precio"       Binding="{Binding Pv, StringFormat=N0}"        Width="80" />
                                <DataGridTextColumn Header="Entrega"      Binding="{Binding EntregaLinea, StringFormat=N0}" Width="80" />
                                <DataGridTextColumn Header="Cuotas"       Binding="{Binding CuotasLinea}"                Width="55" />
                                <DataGridTextColumn Header="Costo mensual" Binding="{Binding CostoMensual, StringFormat=N0}" Width="95" />
                                <DataGridTextColumn Header="Total final"  Binding="{Binding ValorFinal, StringFormat=N0}" Width="85" />
                                <DataGridTextColumn Header="Cantidad"     Binding="{Binding Cantidad, StringFormat=N0}"  Width="65" />
                                <DataGridTextColumn Header="Subtotal"     Binding="{Binding Subtotal, StringFormat=N0}"  Width="85" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Total -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="Total" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TxtTotal" Width="100" Padding="3,2" FontSize="12"
                                     FontWeight="Bold" IsReadOnly="True" Background="#FFFF99" />
                        </StackPanel>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- ══ BOTONERA INFERIOR ══ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,4,0,0">
            <Button x:Name="BtnNuevo" Content="Nuevo" Width="80" Padding="6,4"
                    Background="#336699" Foreground="White" FontWeight="Bold" FontSize="11"
                    Click="OnNuevo" Margin="3,0" />
            <Button x:Name="BtnGuardar" Content="Guardar" Width="80" Padding="6,4"
                    Background="#006600" Foreground="White" FontWeight="Bold" FontSize="11"
                    Click="OnConfirmarVenta" Margin="3,0" />
            <Button Content="Eliminar" Width="80" Padding="6,4"
                    Background="#CC0000" Foreground="White" FontWeight="Bold" FontSize="11"
                    Click="OnEliminar" Margin="3,0" />
            <Button Content="Cerrar" Width="80" Padding="6,4"
                    Background="#666666" Foreground="White" FontWeight="Bold" FontSize="11"
                    Click="OnCancelar" Margin="3,0" />
        </StackPanel>

    </Grid>
</Window>
