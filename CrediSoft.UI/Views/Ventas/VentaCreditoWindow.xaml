                                              Checked="OnFuncionarioPublicoChanged"
                                              Unchecked="OnFuncionarioPublicoChanged"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ═══════════ TAB: GARANTE ═══════════ -->
