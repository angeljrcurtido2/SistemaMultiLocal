                                        BorderBrush="{StaticResource BrC3}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ChipLabel}" Text="CÓNYUGE"/>
                                        <TextBox x:Name="TxtGaranteConyuge"
                                                 Background="Transparent" BorderThickness="0"
                                                 IsReadOnly="True" FontSize="13" FontWeight="Bold"
                                                 Foreground="{StaticResource BrC1}" Padding="0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
