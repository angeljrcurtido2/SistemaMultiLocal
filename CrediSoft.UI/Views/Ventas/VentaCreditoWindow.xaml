<Window x:Class="CrediSoft.UI.Views.Ventas.VentaCreditoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solicitud / Venta a Crédito"
        Width="1360" Height="700"
        MinWidth="1200" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F7"
        KeyDown="OnWindowKeyDown">

    <Window.Resources>

        <!-- ── Brushes ── -->
        <SolidColorBrush x:Key="BrC1"  Color="#124E78"/>
        <SolidColorBrush x:Key="BrC2"  Color="#1F77B4"/>
        <SolidColorBrush x:Key="BrC3"  Color="#D2EBFC"/>
        <SolidColorBrush x:Key="BrC4"  Color="#F0F8FF"/>
        <SolidColorBrush x:Key="BrC5"  Color="#C0281B"/>
        <SolidColorBrush x:Key="BrCF"  Color="#EEF2F7"/>
        <SolidColorBrush x:Key="BrCB"  Color="#D0DAE8"/>
        <SolidColorBrush x:Key="BrCT"  Color="#141F30"/>
        <SolidColorBrush x:Key="BrCS"  Color="#5A6B7C"/>
        <SolidColorBrush x:Key="BrW"   Color="White"/>

        <!-- ── Chip de dato (solo lectura) ── -->
        <Style x:Key="ChipLabel" TargetType="TextBlock">
            <Setter Property="FontSize"      Value="9"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="Foreground"    Value="{StaticResource BrCS}"/>
            <Setter Property="Margin"        Value="0,0,0,2"/>
            <Setter Property="TextWrapping"  Value="Wrap"/>
        </Style>
        <Style x:Key="ChipValue" TargetType="TextBox">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderBrush"      Value="{StaticResource BrCB}"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="Foreground"       Value="{StaticResource BrCT}"/>
            <Setter Property="Padding"          Value="8,5"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="IsReadOnly"       Value="True"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height"           Value="30"/>
        </Style>
        <Style x:Key="ChipValueEdit" TargetType="TextBox" BasedOn="{StaticResource ChipValue}">
            <Setter Property="IsReadOnly"  Value="False"/>
            <Setter Property="Background"  Value="White"/>
        </Style>

        <!-- ── Tab personalizado ── -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{StaticResource BrCS}"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Padding"          Value="20,10"/>
            <Setter Property="FontSize"         Value="12"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderThickness="0,0,0,3"
                                BorderBrush="Transparent"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TabIcon"
                                           Text="{TemplateBinding Tag}"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0"/>
                                <ContentPresenter x:Name="ContentSite"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"
                                                  ContentSource="Header"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush"
                                        Value="{StaticResource BrC2}"/>
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="White"/>
                                <Setter Property="Foreground" Value="{StaticResource BrC1}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"
                                        Value="#F0F6FC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Botón primario ── -->
        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background"      Value="{StaticResource BrC2}"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="12,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Height"          Value="30"/>
        </Style>
        <Style x:Key="BtnSuccess" TargetType="Button" BasedOn="{StaticResource BtnPrimary}">
            <Setter Property="Background" Value="#1E6E42"/>
            <Setter Property="Padding"    Value="14,6"/>
        </Style>

        <!-- ── Grilla: estilos celdas ── -->
        <Style x:Key="CeldaGrid"    TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"            Value="8,0"/>
        </Style>
        <Style x:Key="CeldaGridDer" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment"     Value="Right"/>
            <Setter Property="Margin"            Value="8,0"/>
            <Setter Property="FontWeight"        Value="SemiBold"/>
        </Style>
        <Style x:Key="CeldaGridCen" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment"     Value="Center"/>
            <Setter Property="Margin"            Value="4,0"/>
        </Style>

        <!-- ── Separador de sección dentro de card ── -->
        <Style x:Key="SectionDivider" TargetType="Border">
            <Setter Property="Height"     Value="1"/>
            <Setter Property="Background" Value="{StaticResource BrCB}"/>
            <Setter Property="Margin"     Value="0,10,0,10"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>   <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Cuerpo  -->
            <RowDefinition Height="54"/>   <!-- Footer  -->
        </Grid.RowDefinitions>

        <!-- ════════════════════════════════════════════════════════
             HEADER
             ════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Background="{StaticResource BrC1}">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="4" CornerRadius="2"
                        Background="{StaticResource BrC2}"
                        Margin="0,12,14,12"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="SOLICITUD / VENTA A CRÉDITO"
                               FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Complete los datos de cliente, garante, referencias y mercaderías"
                               FontSize="10" Foreground="#80AACC" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Nº solicitud en header -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                    <!-- Nº actual -->
                    <Border Background="#0E2A40" CornerRadius="8" Padding="10,0"
                            Height="40" VerticalAlignment="Center" Margin="0,0,8,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SOLICITUD Nº" FontSize="8" FontWeight="Bold"
                                       Foreground="#5A8AAA" TextAlignment="Center"/>
                            <TextBox x:Name="TxtNroSolicitud"
                                     IsReadOnly="True" Width="64"
                                     Background="Transparent" Foreground="White"
                                     BorderThickness="0" FontSize="15" FontWeight="Bold"
                                     TextAlignment="Center" Padding="0"/>
                        </StackPanel>
                    </Border>

                    <!-- Botón buscar solicitud — ahora con texto claro -->
                    <Button Height="40" Padding="10,0"
                            Background="#1A3A52" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            ToolTip="Buscar y cargar una solicitud existente por número"
                            Click="OnBuscarSolicitud">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🔍" FontSize="13" VerticalAlignment="Center"
                                       Margin="0,0,5,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="BUSCAR" FontSize="8" FontWeight="Bold"
                                           Foreground="#5A8AAA"/>
                                <TextBlock Text="SOLICITUD" FontSize="8" FontWeight="Bold"
                                           Foreground="#5A8AAA"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Badge estado -->
                <Border Grid.Column="4" CornerRadius="6"
                        Background="#1A3A52" Padding="14,0"
                        VerticalAlignment="Center" Height="34">
                    <TextBlock x:Name="TxtEstado" Text="NUEVO"
                               FontSize="13" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ════════════════════════════════════════════════════════
             CUERPO
             ════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1" Margin="12,10,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>   <!-- Panel fijo izquierdo -->
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>     <!-- Tabs -->
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════
                 PANEL IZQUIERDO FIJO
                 ═══════════════════════════════ -->
            <StackPanel Grid.Column="0">

                <!-- Card Solicitud -->
                <Border Background="White" CornerRadius="10"
                        BorderBrush="{StaticResource BrCB}" BorderThickness="1"
                        Padding="14,12" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock Text="SOLICITUD" FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource BrCS}" Margin="0,0,0,10"/>

                        <TextBlock Style="{StaticResource ChipLabel}" Text="NÚMERO"/>
                        <TextBox x:Name="TxtNumero" Style="{StaticResource ChipValue}"
                                 FontSize="10" Margin="0,0,0,8"/>

                        <!-- Local -->
                        <TextBlock Style="{StaticResource ChipLabel}" Text="LOCAL"/>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnSeleccionarLocal" Grid.Column="0" Content="📍" Height="30" Width="30"
                                    Style="{StaticResource BtnPrimary}" Padding="0"
                                    Click="OnSeleccionarLocal"/>
                            <TextBox x:Name="TxtLocal" Grid.Column="1" Margin="4,0,0,0"
                                     Style="{StaticResource ChipValue}" FontSize="11"
                                     FontWeight="Bold" Foreground="{StaticResource BrC1}"/>
                        </Grid>
                        <TextBox x:Name="TxtLocalNombre" Style="{StaticResource ChipValue}"
                                 FontSize="10" Foreground="{StaticResource BrCS}"
                                 Margin="0,0,0,8"/>

                        <!-- Vendedor -->
                        <TextBlock Style="{StaticResource ChipLabel}" Text="VENDEDOR"/>
                        <Button x:Name="BtnBuscarVendedor"
                                Content="🔍 Seleccionar vendedor"
                                Style="{StaticResource BtnPrimary}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,4"
                                Click="OnBuscarVendedor"/>
                        <TextBox x:Name="TxtVendedor" Style="{StaticResource ChipValue}"
                                 Margin="0,0,0,8"/>

                        <!-- Fechas -->
                        <TextBlock Style="{StaticResource ChipLabel}" Text="FECHA SOLICITUD"/>
                        <DatePicker x:Name="DtpSolicitud" Margin="0,0,0,8"
                                    Height="30" FontSize="11"
                                    Background="White" Foreground="{StaticResource BrCT}"
                                    BorderBrush="{StaticResource BrCB}"/>

                        <TextBlock Style="{StaticResource ChipLabel}" Text="FECHA FIGURAR"/>
                        <DatePicker x:Name="DtpFigurar"
                                    Height="30" FontSize="11"
                                    Background="White" Foreground="{StaticResource BrCT}"
                                    BorderBrush="{StaticResource BrCB}"/>
                    </StackPanel>
                </Border>

                <!-- Card I/E colapsable -->
                <Border Background="White" CornerRadius="10"
                        BorderBrush="{StaticResource BrCB}" BorderThickness="1">
                    <StackPanel>
                        <!-- Header toggle -->
                        <Border x:Name="BdrIEHeader" CornerRadius="9,9,0,0"
                                Background="{StaticResource BrC1}"
                                Cursor="Hand" Padding="14,9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="INGRESOS / EGRESOS"
                                           FontSize="9" FontWeight="Bold" Foreground="#AACCE8"/>
                                <TextBlock x:Name="TxtIEChevron" Grid.Column="1"
                                           Text="▲" FontSize="9" Foreground="#AACCE8"/>
                            </Grid>
                        </Border>

                        <Grid x:Name="PnlIE" Margin="10,8,10,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- INGRESOS -->
                            <StackPanel Grid.Column="0">
                                <Border Background="{StaticResource BrC2}" CornerRadius="4,4,0,0"
                                        Padding="4,3">
                                    <TextBlock Text="ING." FontSize="8" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <Grid Background="{StaticResource BrC4}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Salario" FontSize="9"
                                               VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource BrCS}"/>
                                    <TextBox x:Name="TxtISalario" Grid.Row="0" Grid.Column="1" Text="0"
                                             FontSize="9" TextAlignment="Right" Padding="2,2"
                                             BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrCB}"
                                             Background="Transparent" VerticalContentAlignment="Center"
                                             TextChanged="OnIngresoEgresoChanged"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Honor." FontSize="9"
                                               VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource BrCS}"/>
                                    <TextBox x:Name="TxtIHonorario" Grid.Row="1" Grid.Column="1" Text="0"
                                             FontSize="9" TextAlignment="Right" Padding="2,2"
                                             BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrCB}"
                                             Background="Transparent" VerticalContentAlignment="Center"
                                             TextChanged="OnIngresoEgresoChanged"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Cónyuge" FontSize="9"
                                               VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource BrCS}"/>
                                    <TextBox x:Name="TxtIConyuge" Grid.Row="2" Grid.Column="1" Text="0"
                                             FontSize="9" TextAlignment="Right" Padding="2,2"
                                             BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrCB}"
                                             Background="Transparent" VerticalContentAlignment="Center"
                                             TextChanged="OnIngresoEgresoChanged"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Otros" FontSize="9"
                                               VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource BrCS}"/>
                                    <TextBox x:Name="TxtIOtros" Grid.Row="3" Grid.Column="1" Text="0"
                                             FontSize="9" TextAlignment="Right" Padding="2,2"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnIngresoEgresoChanged"/>
                                </Grid>
                                <Border Background="{StaticResource BrC1}" Padding="4,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="TOT." FontSize="8" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtITotal" Grid.Column="1"
                                                 IsReadOnly="True" FontSize="9" FontWeight="Bold"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="#7EE8A2" TextAlignment="Right"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- EGRESOS -->
                            <StackPanel Grid.Column="2">
                                <Border Background="#9B2335" CornerRadius="4,4,0,0" Padding="4,3">
                                    <TextBlock Text="EGR." FontSize="8" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                                <Grid Background="#FFF5F5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                        <RowDefinition Height="24"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Gtos." FontSize="9"
                                               VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource BrCS}"/>
                                    <TextBox x:Name="TxtEGasto" Grid.Row="0" Grid.Column="1" Text="0"
                                             FontSize="9" TextAlignment="Right" Padding="2,2"
                                             BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrCB}"
                                             Background="Transparent" VerticalContentAlignment="Center"
                                             TextChanged="OnIngresoEgresoChanged"/>
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Cuotas" FontSize="9"
                                               VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource BrCS}"/>
                                    <TextBox x:Name="TxtECuota" Grid.Row="1" Grid.Column="1" Text="0"
                                             FontSize="9" TextAlignment="Right" Padding="2,2"
                                             BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrCB}"
                                             Background="Transparent" VerticalContentAlignment="Center"
                                             TextChanged="OnIngresoEgresoChanged"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Alquil." FontSize="9"
                                               VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource BrCS}"/>
                                    <TextBox x:Name="TxtEAlquiler" Grid.Row="2" Grid.Column="1" Text="0"
                                             FontSize="9" TextAlignment="Right" Padding="2,2"
                                             BorderThickness="0,0,0,1" BorderBrush="{StaticResource BrCB}"
                                             Background="Transparent" VerticalContentAlignment="Center"
                                             TextChanged="OnIngresoEgresoChanged"/>
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Otros" FontSize="9"
                                               VerticalAlignment="Center" Margin="4,0" Foreground="{StaticResource BrCS}"/>
                                    <TextBox x:Name="TxtEOtros" Grid.Row="3" Grid.Column="1" Text="0"
                                             FontSize="9" TextAlignment="Right" Padding="2,2"
                                             Background="Transparent" BorderThickness="0"
                                             VerticalContentAlignment="Center"
                                             TextChanged="OnIngresoEgresoChanged"/>
                                </Grid>
                                <Border Background="#7B1A28" Padding="4,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="TOT." FontSize="8" FontWeight="Bold"
                                                   Foreground="White" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TxtETotal" Grid.Column="1"
                                                 IsReadOnly="True" FontSize="9" FontWeight="Bold"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="#FFAAAA" TextAlignment="Right"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>

            <!-- ═══════════════════════════════
                 TABS PRINCIPAL
                 ═══════════════════════════════ -->
            <TabControl x:Name="MainTabs"
                        Grid.Column="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        SelectionChanged="OnTabChanged">
                <TabControl.Template>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Barra de tabs -->
                            <Border Grid.Row="0" Background="White"
                                    CornerRadius="10,10,0,0"
                                    BorderBrush="{StaticResource BrCB}" BorderThickness="1,1,1,0">
                                <TabPanel IsItemsHost="True" Background="Transparent"
                                          Margin="6,0"/>
                            </Border>
                            <!-- Contenido -->
                            <Border Grid.Row="1" Background="White"
                                    CornerRadius="0,0,10,10"
                                    BorderBrush="{StaticResource BrCB}" BorderThickness="1">
                                <ContentPresenter ContentSource="SelectedContent" Margin="0"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </TabControl.Template>

                <!-- ═══════════ TAB: CLIENTE ═══════════ -->
                <TabItem Header="Cliente" Tag="👤" Style="{StaticResource ModernTabItem}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="20,16,20,16">
                        <StackPanel>
                            <!-- Acción buscar cliente -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" x:Name="BtnBuscarCliente"
                                        Content="👤 Buscar cliente"
                                        Style="{StaticResource BtnPrimary}"
                                        Click="OnBuscarCliente"/>
                                <!-- nombre grande a la derecha del botón -->
                                <TextBox x:Name="TxtClienteNombre" Grid.Column="1"
                                         Margin="10,0" Height="30" FontSize="13"
                                         FontWeight="SemiBold"
                                         Background="Transparent" BorderThickness="0,0,0,2"
                                         BorderBrush="{StaticResource BrC2}"
                                         Foreground="{StaticResource BrC1}"
                                         VerticalContentAlignment="Center"
                                         IsReadOnly="True"
                                         Padding="4,0"/>
                                <Button Grid.Column="2" Content="📋 Historial"
                                        Style="{StaticResource BtnPrimary}"
                                        Margin="0,0,6,0"
                                        Click="OnVerHistorialCliente"/>
                                <Button Grid.Column="3" Content="🪪 Ver cédula"
                                        Style="{StaticResource BtnPrimary}"
                                        Click="OnVerCedulaCliente"/>
                            </Grid>

                            <!-- Panel foto de cédula: previsualización en miniatura si existe,
                                 o aviso + botón para cargarla si el cliente no tiene una — muchos
                                 clientes no tienen foto de cédula cargada y hasta ahora esto solo
                                 se descubría al presionar "Ver cédula" y toparse con el aviso de
                                 "no encontrada", sin forma de cargarla desde acá mismo. -->
                            <Border x:Name="PanelFotoCedula" Margin="0,0,0,14"
                                    Background="#F8FAFC" CornerRadius="8" Padding="12,10"
                                    BorderBrush="{StaticResource BrCB}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="70" Height="46" CornerRadius="4"
                                            Background="#E8EEF6" BorderBrush="{StaticResource BrCB}"
                                            BorderThickness="1" Margin="0,0,12,0">
                                        <Image x:Name="ImgMiniaturaCedula" Stretch="UniformToFill"
                                               Cursor="Hand" ToolTip="Click para ver en grande"
                                               MouseLeftButtonUp="OnClickMiniaturaCedula"/>
                                    </Border>
                                    <TextBlock x:Name="TxtEstadoFotoCedula" Grid.Column="1"
                                               FontSize="11.5" TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource BrCS}"
                                               Text="Seleccione un cliente para ver el estado de su foto de cédula."/>
                                    <Button x:Name="BtnCargarFotoCedula" Grid.Column="2"
                                            Content="📷 Cargar foto de cédula"
                                            Style="{StaticResource BtnPrimary}"
                                            VerticalAlignment="Center"
                                            Click="OnCargarFotoCedula"/>
                                </Grid>
                            </Border>

                            <!-- Fila 1: CI | RUC | Dirección | Sexo -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource ChipLabel}" Text="C.I."/>
                                    <TextBox x:Name="TxtClienteCI" Style="{StaticResource ChipValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource ChipLabel}" Text="RUC"/>
                                    <TextBox x:Name="TxtClienteRUC" Style="{StaticResource ChipValue}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource ChipLabel}" Text="DIRECCIÓN"/>
                                    <TextBox x:Name="TxtClienteDireccion" Style="{StaticResource ChipValue}"/>
