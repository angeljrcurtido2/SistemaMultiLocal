                                                 IsReadOnly="True" FontSize="13" FontWeight="Bold"
                                                 Foreground="{StaticResource BrC5}" Padding="0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Card chip: Cónyuge -->
                                <Border Grid.Column="6" Background="#F8FAFC"
                                        CornerRadius="8" Padding="12,8"
                                        BorderBrush="{StaticResource BrCB}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ChipLabel}" Text="CÓNYUGE"/>
                                        <TextBox x:Name="TxtClienteConyuge"
                                                 Background="Transparent" BorderThickness="0"
                                                 IsReadOnly="True" FontSize="13" FontWeight="Bold"
                                                 Foreground="{StaticResource BrCT}" Padding="0"/>
                                    </StackPanel>
                                </Border>
                                <!-- Card chip: Venc CI -->
                                <Border Grid.Column="8" Background="#FFFBF0"
                                        CornerRadius="8" Padding="12,8"
                                        BorderBrush="#F0E0A0" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ChipLabel}" Text="VENC. C.I."/>
