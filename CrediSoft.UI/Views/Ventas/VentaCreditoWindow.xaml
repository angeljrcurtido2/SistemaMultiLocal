                                    <TextBox x:Name="TxtDescArticulo" Style="{StaticResource ChipValue}"
                                             Background="{StaticResource BrC4}"/>
                                </StackPanel>
                                <StackPanel Grid.Row="0" Grid.Column="5">
                                    <TextBlock Style="{StaticResource ChipLabel}" Text="PRECIO"/>
                                    <TextBox x:Name="TxtPrecioArticulo" Style="{StaticResource ChipValue}"
                                             IsReadOnly="True" Background="{StaticResource BrC4}"
                                             TextChanged="OnArticuloCalcular"/>
                                </StackPanel>
                                <!-- Entrega/Cuotas/%Descuento/%Recargo solo se editan MIENTRAS se
                                     está cargando un artículo (tras buscarlo, antes de pulsar
                                     Ingresar) — igual que el sistema viejo, donde esta barra
                                     queda deshabilitada apenas el artículo pasa a la grilla,
                                     dejando editable únicamente Cantidad (ver
                                     HabilitarEdicionArticulo en el code-behind). -->
