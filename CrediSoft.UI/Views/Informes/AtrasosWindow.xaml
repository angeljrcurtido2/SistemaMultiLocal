<Window x:Class="CrediSoft.UI.Views.Informes.AtrasosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Atrasos - Morosos" Width="1050" Height="600"
        MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#EEF2F6">

    <!-- Réplica visual del panel de criterios del sistema viejo: panel lila fijo a la
         izquierda con los filtros en vertical (radios + botones apilados), en vez de la
         barra horizontal azul que tenía antes. Se conservan los mismos x:Name de todos los
         controles para no romper el code-behind existente (~5000 líneas de lógica). -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ PANEL DE CRITERIOS (lila, izquierda) ══ -->
        <Border Grid.Column="0" Background="#C9C3F0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10,10,10,10">

                    <Border Background="#B3ABE8" Padding="6,6" Margin="0,0,0,8">
                        <TextBlock Text="CRITERIOS DE BÚSQUEDA" FontSize="11" FontWeight="Bold"
                                   Foreground="#14141E" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Todos -->
                    <RadioButton x:Name="RbTodos" Content="Todos los atrasos"
                                 GroupName="FiltroAtraso" IsChecked="True"
                                 Foreground="#14141E" FontSize="11" FontWeight="SemiBold"
                                 Margin="0,0,0,6" Checked="OnCriterioChanged"/>

                    <!-- Período -->
                    <RadioButton x:Name="RbPeriodo" Content="Periodo de tiempo"
                                 GroupName="FiltroAtraso"
                                 Foreground="#14141E" FontSize="11" FontWeight="SemiBold"
                                 Margin="0,0,0,3" Checked="OnCriterioChanged"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="DpDesde" Grid.Column="0" IsEnabled="False"
                                    SelectedDateChanged="OnFiltroAutoSearch"/>
                        <DatePicker x:Name="DpHasta" Grid.Column="2" IsEnabled="False"
                                    SelectedDateChanged="OnFiltroAutoSearch"/>
                    </Grid>

                    <!-- Días mora -->
                    <RadioButton x:Name="RbDias" Content="Días de mora"
                                 GroupName="FiltroAtraso"
                                 Foreground="#14141E" FontSize="11" FontWeight="SemiBold"
                                 Margin="0,0,0,3" Checked="OnCriterioChanged"/>
                    <TextBox x:Name="TxtDias" IsEnabled="False"
                             Background="White" BorderBrush="#8A82C9" BorderThickness="1"
                             Padding="5,3" Margin="0,0,0,6"
                             TextChanged="OnFiltroTextChanged"/>

                    <!-- Intervalo -->
                    <RadioButton x:Name="RbIntervalo" Content="Intervalo de días"
                                 GroupName="FiltroAtraso"
                                 Foreground="#14141E" FontSize="11" FontWeight="SemiBold"
                                 Margin="0,0,0,3" Checked="OnCriterioChanged"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Desde" FontSize="10.5" Foreground="#14141E"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtIntDesde" Grid.Column="1" IsEnabled="False"
                                 Background="White" BorderBrush="#8A82C9" BorderThickness="1"
                                 Padding="4,3" Margin="0,0,8,0"
                                 TextChanged="OnFiltroTextChanged"/>
                        <TextBlock Grid.Column="2" Text="Hasta" FontSize="10.5" Foreground="#14141E"
                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBox x:Name="TxtIntHasta" Grid.Column="3" IsEnabled="False"
                                 Background="White" BorderBrush="#8A82C9" BorderThickness="1"
                                 Padding="4,3"
                                 TextChanged="OnFiltroTextChanged"/>
                    </Grid>

                    <!-- Ordenar por días de mora -->
                    <TextBlock Text="Ordenar por días" FontSize="10.5" FontWeight="SemiBold" Foreground="#14141E" Margin="0,0,0,3"/>
                    <ComboBox x:Name="CboOrdenMora" SelectedIndex="0"
                              Background="White" BorderBrush="#8A82C9" BorderThickness="1"
                              Padding="5,3" Margin="0,0,0,8"
                              SelectionChanged="OnFiltroAutoSearch">
                        <ComboBoxItem Content="Mayor a menor"/>
                        <ComboBoxItem Content="Menor a mayor"/>
                    </ComboBox>

                    <!-- Buscar -->
                    <Button Content="🔍 Buscar" Click="OnBuscar"
                            Height="28" Foreground="White" FontWeight="Bold" FontSize="11.5"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2A4FE0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1F3EC0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Local -->
                    <TextBlock Text="Local" FontSize="10.5" FontWeight="SemiBold" Foreground="#14141E" Margin="0,0,0,3"/>
                    <TextBox x:Name="TxtLocal" IsReadOnly="True" Cursor="Arrow"
                             Background="White" Foreground="#14141E"
                             FontStyle="Italic" FontSize="11"
                             Padding="5,4" Text="(todos)"
                             BorderBrush="#8A82C9" BorderThickness="1" Margin="0,0,0,4"/>
                    <Button x:Name="BtnSelecLocal" Content="Selec. local" Click="OnSeleccionarLocal"
                            Height="24" Foreground="#14141E" FontSize="10.5" FontWeight="SemiBold"
                            BorderThickness="1" Cursor="Hand" Margin="0,0,0,3">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderBrush" Value="#8A82C9"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#EEF2F6"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button x:Name="BtnLimpiarLocal" Content="🌐 Todos los locales" Click="OnLimpiarLocal"
                            Height="24" Foreground="White" FontSize="10.5" FontWeight="SemiBold"
                            BorderThickness="0" Cursor="Hand"
                            Visibility="Collapsed" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#546E7A"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#37474F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <Border Height="1" Background="#8A82C9" Margin="0,0,0,8"/>

                    <!-- Vendedor -->
                    <Button x:Name="BtnSelVendedor" Content="👤 Vendedor" Click="OnSeleccionarVendedor"
                            Height="26" Foreground="White" FontWeight="SemiBold" FontSize="11"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,3">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1A4F6E"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1F6089"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock x:Name="TxtVendedorNombre"
                               Foreground="#14141E" FontSize="10.5" FontWeight="SemiBold"
                               TextWrapping="Wrap" Margin="0,0,0,3" Visibility="Collapsed"/>
                    <Button x:Name="BtnLimpiarVendedor" Content="✕ Quitar filtro vendedor"
                            Click="OnLimpiarVendedor"
                            Height="22" Foreground="White" FontWeight="SemiBold" FontSize="10"
                            BorderThickness="0" Cursor="Hand"
                            Visibility="Collapsed" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#546E7A"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#37474F"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Resumen / Vista previa / Imprimir -->
                    <Button Content="📊 Resumen x local" Click="OnResumenLocal"
                            Height="26" Foreground="White" FontWeight="SemiBold" FontSize="11"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1F6089"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A7AB5"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="👁 Vista previa" Click="OnVistaPrevia"
                            Height="26" Foreground="White" FontWeight="SemiBold" FontSize="11"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2A5F8A"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#3070A0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="🖨 Imprimir" Click="OnImprimir"
                            Height="26" Foreground="White" FontWeight="SemiBold" FontSize="11"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,0,8">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1A4F6E"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1F6089"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Ver todo (COMPLETO) -->
                    <Button x:Name="BtnCompleto" Content="📋 COMPLETO" Click="OnCompleto"
                            Height="28" Foreground="White" FontWeight="Bold" FontSize="11"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1A6B4A"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Background" Value="#546E7A"/>
                                        <Setter Property="Foreground" Value="#B0BEC5"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1E8A5E"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Button.ToolTip>
                            <ToolTip x:Name="TtCompleto"
                                     Background="#0E2F44" Foreground="White"
                                     FontSize="11" Padding="8,5"
                                     Content="Ver todos los atrasos sin filtro"/>
                        </Button.ToolTip>
                    </Button>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══ ÁREA DE RESULTADOS (derecha) ══ -->
        <Grid Grid.Column="1">
            <!-- Filas 2 y 3 (Artículos / Resumen por local) usaban alto fijo en píxeles (160/180),
                 que en pantallas de 768px de alto le restaban ese espacio absoluto a la fila 1 (la
                 grilla principal de morosos, la más importante) sin ceder nada — en resoluciones
                 chicas la grilla principal quedaba comprimida a un margen mínimo. Con MinHeight +
                 Star, las 3 filas compiten proporcionalmente por el espacio sobrante en vez de que
                 las secciones secundarias reclamen un tamaño fijo absoluto. -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="2*" MinHeight="180"/>
                <RowDefinition Height="1*" MinHeight="110"/>
                <RowDefinition Height="1*" MinHeight="120"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0E2F44" Padding="14,10">
                <TextBlock Text="⚠  Atrasos - Morosos"
                           Foreground="White" FontSize="15" FontWeight="Bold"/>
            </Border>

            <!-- ══ GRILLA MOROSOS ══ -->
            <Border Grid.Row="1" Margin="8,6,8,0"
                    BorderBrush="#C5D5E8" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A4F6E" Padding="10,6">
                        <Grid>
                            <TextBlock Text="📋  Listado de morosos"
                                       Foreground="White" FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="LblConteo" HorizontalAlignment="Right"
                                       Foreground="#7FB3D3" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="GridMorosos" Grid.Row="1"
                              Style="{StaticResource CrediGrid}"
                              AlternatingRowBackground="Transparent"
                              RowBackground="Transparent"
                              SelectionChanged="OnMorosoSeleccionado"
                              MouseDoubleClick="OnMorosoDobleClick"
                              RowHeight="20" FontSize="9"
                              ColumnHeaderHeight="20"
                              HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource GridHeaderBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="6,3"/>
                                <Setter Property="FontSize" Value="9.5"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cliente"     Binding="{Binding ClienteNombre}"  Width="150" MinWidth="110"/>
                            <DataGridTextColumn Header="Nro Cédula"  Binding="{Binding ClienteCi}"       Width="80"/>
                            <DataGridTextColumn Header="Teléfono"    Binding="{Binding ClienteTelefono}" Width="95"/>
                            <DataGridTextColumn Header="Solicitud"   Binding="{Binding NSolicitud}"      Width="110"/>
                            <DataGridTextColumn Header="N° Cuota"    Binding="{Binding NCuota}"          Width="70"/>
                            <DataGridTextColumn Header="Monto Gs."   Binding="{Binding Monto, StringFormat=N0}"        Width="90"/>
                            <DataGridTextColumn Header="Vencimiento" Binding="{Binding Vto, StringFormat=dd/MM/yyyy}"  Width="85"/>
                            <DataGridTextColumn Header="Mora"        Binding="{Binding Mora}"            Width="50"/>
                            <DataGridTextColumn Header="Local"       Binding="{Binding IdLocal}"         Width="60"/>
                            <DataGridTextColumn Header="Vendedor"    Binding="{Binding VendedorNombre}"  Width="*" MinWidth="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Barra de totales -->
                    <Border Grid.Row="2" Background="#E8F0F7" Padding="10,5"
                            BorderBrush="#C5D5E8" BorderThickness="0,1,0,0">
                        <TextBlock x:Name="LblTotalMorosos"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="#0E2F44"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ══ ARTÍCULOS ══ -->
            <Border Grid.Row="2" Margin="8,4,8,0"
                    BorderBrush="#C5D5E8" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#1F6089" Padding="10,6">
                        <TextBlock Text="🛒  Artículos de la solicitud seleccionada"
                                   Foreground="White" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <DataGrid x:Name="GridProductos" Grid.Row="1"
                              Style="{StaticResource CrediGrid}"
                              RowHeight="20" FontSize="9"
                              ColumnHeaderHeight="20"
                              HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource GridHeaderBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="FontSize" Value="9"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código"      Binding="{Binding ArticuloCodigo}" Width="110"/>
                            <DataGridTextColumn Header="Descripción" Binding="{Binding ArticuloNombre}" Width="*"/>
                            <DataGridTextColumn Header="Cant."       Binding="{Binding Cantidad, StringFormat=N0}" Width="70"/>
                            <DataGridTextColumn Header="P.Venta"     Binding="{Binding Pv, StringFormat=N0}"      Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ══ RESUMEN POR LOCAL ══ -->
            <Border Grid.Row="3" Margin="8,4,8,6"
                    BorderBrush="#C5D5E8" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0E2F44" Padding="10,6">
                        <TextBlock Text="📊  Resumen de atrasos por local"
                                   Foreground="White" FontWeight="Bold" FontSize="11"/>
                    </Border>
                    <DataGrid x:Name="GridResumen" Grid.Row="1"
                              Style="{StaticResource CrediGrid}"
                              RowHeight="20" FontSize="9"
                              ColumnHeaderHeight="20"
                              HeadersVisibility="Column" RowHeaderWidth="0">
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6,0"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{StaticResource GridHeaderBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Padding" Value="5,2"/>
                                <Setter Property="FontSize" Value="9"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Local}" Value="── TOTALES GENERALES">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Background" Value="#E8F0F7"/>
                                        <Setter Property="Foreground" Value="#0E2F44"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Local"        Binding="{Binding Local}"                        Width="180"/>
                            <DataGridTextColumn Header="Tot.Atrasos"  Binding="{Binding TotalAtrasos, StringFormat=N0}" Width="*"/>
                            <DataGridTextColumn Header="1-30 días"    Binding="{Binding Atr1a30,   StringFormat=N0}"   Width="110"/>
                            <DataGridTextColumn Header="31-60 días"   Binding="{Binding Atr31a60,  StringFormat=N0}"   Width="110"/>
                            <DataGridTextColumn Header="61-90 días"   Binding="{Binding Atr61a90,  StringFormat=N0}"   Width="110"/>
                            <DataGridTextColumn Header="+90 días"     Binding="{Binding AtrMas90,  StringFormat=N0}"   Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
