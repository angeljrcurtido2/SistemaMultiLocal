<Window x:Class="CrediSoft.UI.Views.Retiros.RetiroLibreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Retiro libre de mercadería — ElectroMar"
        Width="980" Height="660"
        MinWidth="880" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">

    <Window.Resources>

        <!-- ── Botones ── -->
        <Style x:Key="BtnBlue" TargetType="Button">
            <Setter Property="Background"      Value="#1565C0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0D47A1"/></Trigger>
                <Trigger Property="IsEnabled"   Value="False"><Setter Property="Background" Value="#B0BEC5"/><Setter Property="Foreground" Value="#607D8B"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnGreen" TargetType="Button">
            <Setter Property="Background"      Value="#2E7D32"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="18,8"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1B5E20"/></Trigger>
                <Trigger Property="IsEnabled"   Value="False"><Setter Property="Background" Value="#B0BEC5"/><Setter Property="Foreground" Value="#607D8B"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnGray" TargetType="Button">
            <Setter Property="Background"      Value="#ECEFF1"/>
            <Setter Property="Foreground"      Value="#37474F"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#B0BEC5"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#CFD8DC"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnOrange" TargetType="Button">
            <Setter Property="Background"      Value="#E65100"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="10,6"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#BF360C"/></Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── Campos ── -->
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Padding"         Value="7,6"/>
            <Setter Property="BorderBrush"     Value="#CFD8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldRO" TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#546E7A"/>
            <Setter Property="Margin"     Value="0,0,0,4"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1565C0"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"       Value="White"/>
            <Setter Property="BorderBrush"      Value="#E0E0E0"/>
            <Setter Property="BorderThickness"  Value="1"/>
            <Setter Property="CornerRadius"     Value="4"/>
            <Setter Property="Padding"          Value="14,12"/>
        </Style>

        <!-- ── DataGrid ── -->
        <Style TargetType="DataGrid">
            <Setter Property="AlternatingRowBackground"   Value="#F8F9FA"/>
            <Setter Property="RowBackground"              Value="White"/>
            <Setter Property="GridLinesVisibility"        Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush"   Value="#EEEEEE"/>
            <Setter Property="BorderThickness"            Value="1"/>
            <Setter Property="BorderBrush"                Value="#E0E0E0"/>
            <Setter Property="FontSize"                   Value="12"/>
            <Setter Property="CanUserAddRows"             Value="False"/>
            <Setter Property="CanUserResizeRows"          Value="False"/>
            <Setter Property="SelectionMode"              Value="Single"/>
            <Setter Property="HeadersVisibility"          Value="Column"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"   Value="#1565C0"/>
            <Setter Property="Foreground"   Value="White"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="Padding"      Value="8,6"/>
            <Setter Property="BorderBrush"  Value="#0D47A1"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E3F2FD"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ══════════════════════════════════════════
             HEADER AZUL
        ══════════════════════════════════════════ -->
        <Border DockPanel.Dock="Top" Background="#1565C0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Ícono -->
                <Border Grid.Column="0" Background="#0D47A1" CornerRadius="4"
                        Padding="10,8" Margin="0,0,14,0" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8FB;" FontFamily="Segoe MDL2 Assets"
                               FontSize="22" Foreground="White"/>
                </Border>

                <!-- Títulos -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="RETIRO LIBRE DE MERCADERÍA"
                               FontSize="16" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Registrar salida de artículo sin venta — descuenta stock"
                               FontSize="11" Foreground="#90CAF9"/>
                </StackPanel>

                <!-- Info sesión + cerrar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0D47A1" CornerRadius="3" Padding="10,5" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="#90CAF9" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="TxtUsuarioSesion" Text="Usuario" Foreground="White" FontSize="11"/>
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource BtnGray}" Padding="10,5"
                            Content="✕  Cerrar" Click="OnCerrar"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             PIE — ACEPTAR / CERRAR
        ══════════════════════════════════════════ -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Resumen de la operación -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtResumenOp" Text="Seleccioná un artículo para registrar el retiro"
                               Foreground="#78909C" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="BtnAceptar" Grid.Column="1" Style="{StaticResource BtnGreen}"
                        IsEnabled="False" Click="OnAceptar">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Confirmar retiro  (F5)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Style="{StaticResource BtnGray}"
                        Content="Cerrar  (Esc)" Click="OnCerrar"/>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             CUERPO PRINCIPAL: izquierda + derecha
        ══════════════════════════════════════════ -->
        <Grid Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="420"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="320" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <!-- ─────────────────────────────────────
                 COLUMNA IZQUIERDA: búsqueda + grilla
            ───────────────────────────────────────── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Barra de búsqueda + local -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="12,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Local -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource Lbl}"
                                       Text="LOCAL:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="TxtLocalId" Grid.Column="1" Style="{StaticResource Field}"
                                     KeyDown="OnLocalIdKeyDown" MaxLength="5"/>
                            <TextBox x:Name="TxtLocalNombre" Grid.Column="3" Style="{StaticResource FieldRO}"
                                     Text="— seleccionar local —"/>
                            <Button Grid.Column="5" Style="{StaticResource BtnOrange}"
                                    Content="&#xE721;  F8" FontSize="11" Click="OnBuscarLocal"
                                    ToolTip="Buscar local (F8)"/>
                        </Grid>

                        <!-- Búsqueda de artículo -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Wrapper con placeholder superpuesto -->
                            <Grid Grid.Column="0">
                                <TextBox x:Name="TxtBusqueda" Style="{StaticResource Field}"
                                         KeyDown="OnBusquedaKeyDown" TextChanged="OnBusquedaChanged"/>
                                <TextBlock x:Name="TxtPlaceholder"
                                           Text="  Buscar por código o descripción..."
                                           Foreground="#90A4AE" FontSize="12"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="4,0"/>
                            </Grid>
                            <Button Grid.Column="2" Style="{StaticResource BtnBlue}"
                                    Content="Buscar" Click="OnBuscarArticulo"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Grilla de artículos -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Cabecera grilla -->
                        <Border Grid.Row="0" Background="#F5F7FA" BorderBrush="#E0E0E0"
                                BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}"
                                           Text="&#xE8A9;  ARTÍCULOS DISPONIBLES" Margin="0"/>
                                <TextBlock x:Name="TxtContadorArts" Grid.Column="1"
                                           Foreground="#78909C" FontSize="11" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid -->
                        <DataGrid x:Name="GridArticulos" Grid.Row="1"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  SelectionChanged="OnArticuloSeleccionado"
                                  MouseDoubleClick="OnArticuloDobleClick"
                                  VirtualizingPanel.IsVirtualizing="True"
                                  VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"         Color="#1565C0"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"     Color="White"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#90CAF9"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A237E"/>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código"      Binding="{Binding Ca}"        Width="90"  FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Descripción" Binding="{Binding D}"         Width="*"/>
                                <DataGridTextColumn Header="Marca"       Binding="{Binding MarcaNombre}" Width="100"/>
                                <DataGridTextColumn Header="Stock local" Binding="{Binding StockLocal}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="0,0,6,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SinStock}" Value="True">
                                                    <Setter Property="Foreground" Value="#E53935"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Hint clic -->
                        <Border Grid.Row="2" Background="#E3F2FD" Padding="10,6">
                            <TextBlock Text="&#xE7C1;  Hacé clic en un artículo para ver detalle  ·  Doble clic para seleccionar rápidamente"
                                       Foreground="#1565C0" FontSize="11"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ─────────────────────────────────────
                 COLUMNA DERECHA: detalle + cantidad + stock locales
                 Usar Grid con filas fijas para que el panel inferior
                 siempre tenga espacio garantizado
            ───────────────────────────────────────── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"    MinHeight="260"/>  <!-- detalle artículo -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>                  <!-- cantidad -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="180"/>                   <!-- stock otros locales, altura fija -->
                </Grid.RowDefinitions>

                <!-- Detalle del artículo seleccionado -->
                <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>  <!-- título -->
                            <RowDefinition Height="Auto"/>  <!-- código -->
                            <RowDefinition Height="*"/>     <!-- descripción (crece) -->
                            <RowDefinition Height="Auto"/>  <!-- marca -->
                            <RowDefinition Height="Auto"/>  <!-- badge stock -->
                            <RowDefinition Height="Auto"/>  <!-- placeholder -->
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource SectionTitle}"
                                   Text="&#xE7C5;  ARTÍCULO SELECCIONADO"/>

                        <!-- Código -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Lbl}" Text="CÓDIGO"/>
                            <TextBox x:Name="TxtDetCodigo" Style="{StaticResource FieldRO}"
                                     FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Descripción -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Lbl}" Text="DESCRIPCIÓN"/>
                            <TextBox x:Name="TxtDetDescripcion" Style="{StaticResource FieldRO}"
                                     TextWrapping="Wrap" MinHeight="38" MaxHeight="72"/>
                        </StackPanel>

                        <!-- Marca -->
                        <StackPanel Grid.Row="3" Margin="0,0,0,10">
                            <TextBlock Style="{StaticResource Lbl}" Text="MARCA"/>
                            <TextBox x:Name="TxtDetMarca" Style="{StaticResource FieldRO}"/>
                        </StackPanel>

                        <!-- Badge stock OK -->
                        <Border x:Name="PanelStockOK" Grid.Row="4"
                                Background="#E8F5E9" BorderBrush="#A5D6A7"
                                BorderThickness="1" CornerRadius="4" Padding="10,8"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="STOCK EN ESTE LOCAL" Foreground="#388E3C"
                                               FontSize="9" FontWeight="Bold"/>
                                    <TextBlock x:Name="TxtStockLocal" Text="0"
                                               FontSize="22" FontWeight="Bold" Foreground="#2E7D32"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           Foreground="#A5D6A7" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Badge sin stock -->
                        <Border x:Name="PanelStockCero" Grid.Row="4"
                                Background="#FFEBEE" BorderBrush="#EF9A9A"
                                BorderThickness="1" CornerRadius="4" Padding="10,8"
                                Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="SIN STOCK EN ESTE LOCAL" Foreground="#C62828"
                                           FontSize="9" FontWeight="Bold"/>
                                <TextBlock Text="0 unidades disponibles"
                                           FontSize="13" Foreground="#E53935"/>
                            </StackPanel>
                        </Border>

                        <!-- Placeholder sin selección -->
                        <Border x:Name="PanelSinSeleccion" Grid.Row="5"
                                Background="#F5F7FA" BorderBrush="#E0E0E0"
                                BorderThickness="1" CornerRadius="4" Padding="10,14" Margin="0,4,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="32" Foreground="#CFD8DC"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Ningún artículo seleccionado"
                                           Foreground="#90A4AE" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Panel CANTIDAD -->
                <Border Grid.Row="2" Style="{StaticResource Card}" x:Name="PanelCantidad"
                        IsEnabled="False">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="&#xE8EF;  CANTIDAD A RETIRAR"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="44"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtCantidad" Grid.Column="0" Style="{StaticResource Field}"
                                     Text="1" FontSize="20" FontWeight="Bold"
                                     TextAlignment="Center" KeyDown="OnCantidadKeyDown"
                                     GotFocus="OnCantFocus"/>
                            <Button Grid.Column="2" Content="−" FontSize="18" FontWeight="Bold"
                                    Style="{StaticResource BtnGray}" Padding="0"
                                    Click="OnMenos" Height="36"/>
                            <Button Grid.Column="4" Content="+" FontSize="18" FontWeight="Bold"
                                    Style="{StaticResource BtnBlue}" Padding="0"
                                    Click="OnMas" Height="36"/>
                        </Grid>
                        <Border x:Name="PanelAdvertencia" Background="#FFF8E1" BorderBrush="#FFE082"
                                BorderThickness="1" CornerRadius="3" Padding="8,5"
                                Margin="0,8,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="TxtAdvertencia"
                                       Foreground="#F57F17" FontSize="11" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Stock en TODOS los locales — altura fija + scroll -->
                <Border Grid.Row="4" Background="White" BorderBrush="#E0E0E0"
                        BorderThickness="1" CornerRadius="4" Padding="0" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34"/>   <!-- cabecera fija -->
                            <RowDefinition Height="*"/>    <!-- grilla con scroll -->
                        </Grid.RowDefinitions>

                        <!-- Cabecera -->
                        <Border Grid.Row="0" Background="#37474F" CornerRadius="4,4,0,0" Padding="12,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="STOCK EN TODOS LOS LOCALES"
                                           Foreground="White" FontSize="10" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtTotalLocales" Grid.Column="1"
                                           Foreground="#90A4AE" FontSize="10"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- DataGrid con scroll propio -->
                        <DataGrid x:Name="GridStockLocales" Grid.Row="1"
                                  IsReadOnly="True" AutoGenerateColumns="False"
                                  CanUserResizeColumns="False"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  BorderThickness="0">
                            <DataGrid.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"     Color="#455A64"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="White"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#ECEFF1"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#37474F"/>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Cursor" Value="Arrow"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#ECEFF1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Local" Binding="{Binding LocalNombre}"
                                                    Width="*" FontSize="12"/>
                                <DataGridTextColumn Header="Stock" Binding="{Binding S}"
                                                    Width="64" FontSize="12" FontWeight="SemiBold">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding"             Value="0,0,8,0"/>
                                            <Setter Property="Foreground"          Value="#1565C0"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

    </DockPanel>
</Window>
