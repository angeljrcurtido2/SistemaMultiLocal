<Window x:Class="CrediSoft.UI.Views.Cobros.ArticulosModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Artículos del crédito"
        Width="560" Height="420"
        MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="BtnGray" TargetType="Button">
            <Setter Property="Background"      Value="#ECEFF1"/>
            <Setter Property="Foreground"      Value="#37474F"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#B0BEC5"/>
            <Setter Property="Padding"         Value="16,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CFD8DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#1565C0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtTitulo" Text="ARTÍCULOS DEL CRÉDITO"
                                   FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TxtSubtitulo" Text="Cargando..."
                                   FontSize="11" Foreground="#90CAF9"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕  Cerrar" Style="{StaticResource BtnGray}"
                        Padding="12,6" Click="OnCerrar"/>
            </Grid>
        </Border>

        <!-- Totales pie -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="TOTAL VENTA:" FontSize="11" Foreground="#90A4AE"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtTotal" Text="Gs. —" FontSize="14"
                           FontWeight="Bold" Foreground="#1565C0" VerticalAlignment="Center"/>
                <TextBlock Text="ARTÍCULOS:" FontSize="11" Foreground="#90A4AE"
                           VerticalAlignment="Center" Margin="24,0,8,0"/>
                <TextBlock x:Name="TxtCantItems" Text="—" FontSize="14"
                           FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Grid artículos -->
        <Border Background="White" Margin="12,10,12,0"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="GridArticulos"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      HeadersVisibility="Column"
                      CanUserReorderColumns="False" CanUserResizeRows="False"
                      Background="White" RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"      Value="#1565C0"/>
                        <Setter Property="Foreground"      Value="White"/>
                        <Setter Property="FontWeight"      Value="SemiBold"/>
                        <Setter Property="FontSize"        Value="12"/>
                        <Setter Property="Padding"         Value="8,7"/>
                        <Setter Property="BorderBrush"     Value="#0D47A1"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="26"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="#0D47A1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding"         Value="6,2"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Descripción" Binding="{Binding Descripcion}" Width="*"/>
                    <DataGridTextColumn Header="Cantidad"    Binding="{Binding Cantidad, StringFormat=N0}"    Width="80"/>
                    <DataGridTextColumn Header="P. Venta Gs." Binding="{Binding PVenta, StringFormat=N0}" Width="120"/>
                    <DataGridTextColumn Header="Subtotal Gs." Binding="{Binding Subtotal, StringFormat=N0}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </DockPanel>
</Window>
