<Window x:Class="CrediSoft.UI.Views.Cobros.CobrosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cobrar Cuota" Width="820" Height="580"
        WindowStartupLocation="CenterOwner"
        Background="#FFA500">

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Búsqueda cliente -->
        <Border Grid.Row="0" Background="#E07000" Padding="8,6" CornerRadius="4" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="CI del cliente:" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox x:Name="TxtCi" Width="140" Padding="4,3" Background="White" KeyDown="OnCiKeyDown" />
                <Button Content="🔍 Buscar" Margin="6,0,0,0" Padding="10,4"
                        Background="White" Click="OnBuscarCliente" />
                <TextBlock x:Name="TxtClienteNombre" Foreground="White" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="16,0,0,0" FontSize="14" />
            </StackPanel>
        </Border>

        <!-- Resumen cliente -->
        <Border Grid.Row="1" Background="White" Padding="8,6" Margin="0,0,0,6" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Teléfono" FontSize="11" Foreground="#666" />
                    <TextBlock x:Name="TxtTelefono" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Ciudad" FontSize="11" Foreground="#666" />
                    <TextBlock x:Name="TxtCiudad" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Estado" FontSize="11" Foreground="#666" />
                    <TextBlock x:Name="TxtEstado" FontWeight="SemiBold" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Crédito máx." FontSize="11" Foreground="#666" />
                    <TextBlock x:Name="TxtCredMax" FontWeight="SemiBold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grid cuotas -->
        <DataGrid x:Name="GridCuotas" Grid.Row="2" Style="{StaticResource CrediGrid}"
                  SelectionChanged="OnCuotaSeleccionada">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding EstaVencida}" Value="True">
                            <Setter Property="Background" Value="#FFE0E0" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="N° Cuota"   Binding="{Binding NCuota}"           Width="70" />
                <DataGridTextColumn Header="Solicitud"  Binding="{Binding NSolicitud}"        Width="130" />
                <DataGridTextColumn Header="Vencimiento" Binding="{Binding Vto, StringFormat=dd/MM/yyyy}" Width="110" />
                <DataGridTextColumn Header="Monto Gs."  Binding="{Binding Monto, StringFormat=N0}" Width="100" />
                <DataGridTextColumn Header="Días mora"  Binding="{Binding DiasDeAtraso}"      Width="90" />
                <DataGridTextColumn Header="Punitorio"  Binding="{Binding Punitorio, StringFormat=N0}" Width="90" />
                <DataGridTextColumn Header="Total"      Binding="{Binding Total, StringFormat=N0}" Width="100" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Panel de cobro -->
        <Border Grid.Row="3" Background="White" Padding="12,8" Margin="0,6,0,6" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Monto cuota" FontSize="11" Foreground="#666" />
                    <TextBox x:Name="TxtMontoCuota" IsReadOnly="True" Padding="4,3"
                             Background="#F5F5F5" FontWeight="Bold" FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Punitorio" FontSize="11" Foreground="#666" />
                    <TextBox x:Name="TxtPunitorio" IsReadOnly="True" Padding="4,3"
                             Background="#FFE0E0" FontWeight="Bold" FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="TOTAL A COBRAR" FontSize="11" Foreground="#CC0000" FontWeight="Bold" />
                    <TextBox x:Name="TxtTotalCobrar" IsReadOnly="True" Padding="4,3"
                             Background="#FFF3CD" FontWeight="Bold" FontSize="16"
                             Foreground="#CC0000" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Forma de pago" FontSize="11" Foreground="#666" />
                    <ComboBox x:Name="CboFormaPago" Padding="4,3">
                        <ComboBoxItem Content="Efectivo" IsSelected="True" />
                        <ComboBoxItem Content="Tarjeta" />
                        <ComboBoxItem Content="Transferencia" />
                        <ComboBoxItem Content="Cheque" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Bottom">
                    <Button x:Name="BtnCobrar" Content="✅ COBRAR" Width="120" Height="36"
                            Style="{StaticResource BtnSuccess}"
                            IsEnabled="False" Click="OnCobrar" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Botones -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="F1=Ayuda  F2=Buscar  Ctrl+S=Cerrar"
                       FontSize="11" Foreground="#333" VerticalAlignment="Center" Margin="0,0,16,0" />
            <Button Content="Cerrar" Style="{StaticResource BtnSecondary}" Width="80" Click="OnCerrar" />
        </StackPanel>
    </Grid>
</Window>
