<Window x:Class="CrediSoft.UI.Views.Cobros.HistorialCobrosModal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Historial de cobros"
        Width="900" Height="500"
        MinWidth="720" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="#F0F2F5"
        FontFamily="Segoe UI" FontSize="13"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="BtnGray" TargetType="Button">
            <Setter Property="Background"      Value="#ECEFF1"/>
            <Setter Property="Foreground"      Value="#37474F"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#B0BEC5"/>
            <Setter Property="Padding"         Value="16,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CFD8DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#455A64" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE823;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock x:Name="TxtTitulo" Text="HISTORIAL DE COBROS"
                                   FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TxtSubtitulo" Text="Cargando..."
                                   FontSize="11" Foreground="#B0BEC5"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Style="{StaticResource BtnGray}"
                        Padding="8,4" Click="OnCerrar" ToolTip="Cerrar"/>
            </Grid>
        </Border>

        <!-- Totales pie -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="CUOTAS TOTALES" FontSize="10" Foreground="#90A4AE"/>
                    <TextBlock x:Name="TxtTotCuotas" Text="—" FontWeight="Bold" Foreground="#37474F"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="COBRADAS" FontSize="10" Foreground="#90A4AE"/>
                    <TextBlock x:Name="TxtTotCobradas" Text="—" FontWeight="Bold" Foreground="#2E7D32"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="PENDIENTES" FontSize="10" Foreground="#90A4AE"/>
                    <TextBlock x:Name="TxtTotPendientes" Text="—" FontWeight="Bold" Foreground="#E65100"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="MORA TOTAL (días)" FontSize="10" Foreground="#90A4AE"/>
                    <TextBlock x:Name="TxtTotMora" Text="—" FontWeight="Bold" Foreground="#C62828"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Content="✕  Cerrar" Click="OnCerrar" Style="{StaticResource BtnGray}"
                            Padding="12,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Grid historial -->
        <Border Background="White" Margin="12,10,12,0"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="GridHistorial"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F0F0F0"
                      HeadersVisibility="Column"
                      CanUserReorderColumns="False" CanUserResizeRows="False"
                      Background="White" RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      BorderThickness="0">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background"      Value="#455A64"/>
                        <Setter Property="Foreground"      Value="White"/>
                        <Setter Property="FontWeight"      Value="SemiBold"/>
                        <Setter Property="FontSize"        Value="12"/>
                        <Setter Property="Padding"         Value="8,7"/>
                        <Setter Property="BorderBrush"     Value="#37474F"/>
                        <Setter Property="BorderThickness" Value="0,0,1,0"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Height" Value="26"/>
                        <Style.Triggers>
                            <!-- Cobrada → verde -->
                            <DataTrigger Binding="{Binding Estado}" Value="Cancelado">
                                <Setter Property="Background" Value="#E8F5E9"/>
                                <Setter Property="Foreground" Value="#2E7D32"/>
                            </DataTrigger>
                            <!-- Pendiente vencida → rojo tenue -->
                            <DataTrigger Binding="{Binding EstadoVencida}" Value="True">
                                <Setter Property="Background" Value="#FFEBEE"/>
                                <Setter Property="Foreground" Value="#C62828"/>
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#E3F2FD"/>
                                <Setter Property="Foreground" Value="#0D47A1"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding"         Value="6,2"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}"
                                            Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="N° Cuota"     Binding="{Binding NCuotaTexto}"              Width="70"/>
                    <DataGridTextColumn Header="Monto Gs."    Binding="{Binding Monto, StringFormat=N0}"   Width="100"/>
                    <DataGridTextColumn Header="Vencimiento"  Binding="{Binding Vto}"                      Width="95"/>
                    <DataGridTextColumn Header="Estado"       Binding="{Binding Estado}"                   Width="85"/>
                    <DataGridTextColumn Header="Mora (días)"  Binding="{Binding Mora}"                     Width="80"/>
                    <DataGridTextColumn Header="Fecha de pago" Binding="{Binding FechaPago}"                Width="100"/>
                    <DataGridTextColumn Header="Días vto.→pago" Binding="{Binding DiasVtoAPago}"            Width="100"/>
                    <DataGridTextColumn Header="Obs."         Binding="{Binding Obs}"                      Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

    </DockPanel>
</Window>
