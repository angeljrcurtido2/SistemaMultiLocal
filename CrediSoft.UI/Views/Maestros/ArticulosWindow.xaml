<Window x:Class="CrediSoft.UI.Views.Maestros.ArticulosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Artículos/Mercaderías"
        Width="260" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="#FFA500"
        ResizeMode="NoResize"
        KeyDown="OnWindowKeyDown">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título -->
        <Border Grid.Row="0" Background="#CC6600" Padding="8,6">
            <TextBlock Text="Artículos y/o Mercaderías"
                       Foreground="White" FontWeight="Bold" FontSize="12"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- Botones principales -->
        <StackPanel Grid.Row="1" Margin="20,16,20,8" VerticalAlignment="Top">

            <!-- NUEVO -->
            <Button Content="NUEVO" Click="OnNuevo"
                    Background="#27AE60" Foreground="White"
                    FontWeight="Bold" FontSize="13"
                    Height="34" Margin="0,0,0,10"
                    BorderThickness="0"/>

            <!-- EDITAR con subitems -->
            <Border Background="#1F6FAE" CornerRadius="2" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="EDITAR" Foreground="White" FontWeight="Bold"
                               FontSize="13" HorizontalAlignment="Center"
                               Margin="0,6,0,4"/>
                    <Button Content=" General" Click="OnEditarGeneral"
                            Background="#2980B9" Foreground="White"
                            FontSize="11" Height="26" BorderThickness="0"
                            HorizontalContentAlignment="Left" Padding="16,0,0,0"/>
                    <Button Content=" Precios" Click="OnEditarPrecios"
                            Background="#2980B9" Foreground="White"
                            FontSize="11" Height="26" BorderThickness="0"
                            HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Margin="0,1,0,0"/>
                    <Button Content=" Stock" Click="OnEditarStock"
                            Background="#2980B9" Foreground="White"
                            FontSize="11" Height="26" BorderThickness="0"
                            HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Margin="0,1,0,0"/>
                    <Button Content=" Secc-Cat" Click="OnEditarSeccCat"
                            Background="#2980B9" Foreground="White"
                            FontSize="11" Height="26" BorderThickness="0"
                            HorizontalContentAlignment="Left" Padding="16,0,0,0"
                            Margin="0,1,0,6"/>
                </StackPanel>
            </Border>

            <!-- INHABILITAR -->
            <Button Content="INHABILITAR" Click="OnInhabilitar"
                    Background="#8E44AD" Foreground="White"
                    FontWeight="Bold" FontSize="13"
                    Height="34" Margin="0,0,0,8"
                    BorderThickness="0"/>

            <!-- HABILITAR -->
            <Button Content="HABILITAR" Click="OnHabilitar"
                    Background="#C0392B" Foreground="White"
                    FontWeight="Bold" FontSize="13"
                    Height="34" Margin="0,0,0,8"
                    BorderThickness="0"/>

            <!-- CERRAR -->
            <Button Content="CERRAR" Click="OnCerrar"
                    Background="#555555" Foreground="White"
                    FontWeight="Bold" FontSize="13"
                    Height="34" BorderThickness="0"/>
        </StackPanel>

        <!-- Atajos de teclado -->
        <Border Grid.Row="2" Background="#CC6600" Padding="6,4">
            <TextBlock Text="Ctrl+N=Nuevo  F2=Editar General  F3=Editar Precios  F4=Stock  F5=Secc-Cat"
                       Foreground="#FFE0B2" FontSize="9"
                       HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>
