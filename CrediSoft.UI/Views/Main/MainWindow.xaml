<Window x:Class="CrediSoft.UI.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ElectroMar"
        WindowState="Maximized"
        Background="#EBF3F8"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>

        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,4"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Margin"          Value="1,0"/>
            <Setter Property="Foreground"      Value="#1A4F6E"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#D6EAF8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#AED6F1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolbarSep" TargetType="Separator">
            <Setter Property="Margin" Value="3,2"/>
        </Style>

        <!-- KPI card -->
        <Style x:Key="KpiCard" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"      Value="20,16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="8" Opacity="0.07" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Panel card (listas del dashboard) -->
        <Style x:Key="DashCard" TargetType="Border">
            <Setter Property="Background"   Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" BlurRadius="10" Opacity="0.08" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Header de panel dashboard -->
        <Style x:Key="DashHdr" TargetType="Border">
            <Setter Property="Padding"      Value="16,12"/>
            <Setter Property="CornerRadius" Value="8,8,0,0"/>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ══ MENÚ PRINCIPAL ══ -->
        <Menu DockPanel.Dock="Top" Background="#0E2F44" Foreground="White"
              FontWeight="SemiBold" FontSize="13" Padding="4,0">
            <Menu.Resources>
                <Style x:Key="Ico" TargetType="TextBlock">
                    <Setter Property="FontFamily"        Value="Segoe MDL2 Assets"/>
                    <Setter Property="FontSize"          Value="14"/>
                    <Setter Property="Foreground"        Value="#1A4F6E"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                    <Setter Property="Width"             Value="18"/>
                    <Setter Property="TextAlignment"     Value="Center"/>
                </Style>
                <Style TargetType="MenuItem">
                    <Setter Property="Foreground"    Value="#1A1A1A"/>
                    <Setter Property="Background"    Value="White"/>
                    <Setter Property="FontWeight"    Value="Normal"/>
                    <Setter Property="FontSize"      Value="13"/>
                    <Setter Property="Padding"       Value="14,9,36,9"/>
                    <Setter Property="MinWidth"      Value="220"/>
                    <Style.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Foreground"  Value="White"/>
                            <Setter Property="Background"  Value="Transparent"/>
                            <Setter Property="FontWeight"  Value="SemiBold"/>
                            <Setter Property="Padding"     Value="16,8"/>
                            <Setter Property="MinWidth"    Value="0"/>
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter Property="Foreground"  Value="White"/>
                            <Setter Property="Background"  Value="Transparent"/>
                            <Setter Property="FontWeight"  Value="SemiBold"/>
                            <Setter Property="Padding"     Value="16,8"/>
                            <Setter Property="MinWidth"    Value="0"/>
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter Property="Background"  Value="#EBF3F8"/>
                            <Setter Property="Foreground"  Value="#0E2F44"/>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHighlighted" Value="True"/>
                                <Condition Property="Role"          Value="TopLevelHeader"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background"  Value="#1A4F6E"/>
                            <Setter Property="Foreground"  Value="White"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHighlighted" Value="True"/>
                                <Condition Property="Role"          Value="TopLevelItem"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background"  Value="#1A4F6E"/>
                            <Setter Property="Foreground"  Value="White"/>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSubmenuOpen" Value="True"/>
                                <Condition Property="Role"          Value="TopLevelHeader"/>
                            </MultiTrigger.Conditions>
                            <Setter Property="Background"  Value="#1A4F6E"/>
                            <Setter Property="Foreground"  Value="White"/>
                        </MultiTrigger>
                    </Style.Triggers>
                </Style>
                <Style TargetType="Separator">
                    <Setter Property="Background" Value="#E8E8E8"/>
                    <Setter Property="Height"     Value="1"/>
                    <Setter Property="Margin"     Value="10,4"/>
                </Style>
            </Menu.Resources>

            <!-- ARCHIVOS -->
            <MenuItem Header="Archivos">
                <MenuItem Header="Artículos..."      Click="OnMenuArticulos">   <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE7C4;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Bancos..."         Click="OnMenuBancos">      <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE825;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Categorías..."     Click="OnMenuCategorias">  <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8FD;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Subcategorías..."  Click="OnMenuSubcategorias"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8B7;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Clientes..."       Click="OnMenuClientes">    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE716;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Funcionarios..."   Click="OnMenuFuncionarios"> <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE77B;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Locales..."        Click="OnMenuLocales">     <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE731;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Marcas..."         Click="OnMenuMarcas">      <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8EC;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Procedencias..."   Click="OnMenuProcedencias"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE909;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Proveedores..."    Click="OnMenuProveedores"> <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE83F;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Secciones..."      Click="OnMenuSecciones">   <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8B1;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Unds. de medidas..." Click="OnMenuMedidas">  <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8EF;"/></MenuItem.Icon></MenuItem>
                <Separator/>
                <MenuItem Header="Cerrar sesión" Click="OnMenuCerrarSesion"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE77B;" Foreground="#F57C00"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Salir" Click="OnMenuSalir"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE7E8;" Foreground="#E53935"/></MenuItem.Icon></MenuItem>
            </MenuItem>

            <!-- MOVIMIENTOS -->
            <MenuItem Header="Movimientos">
                <MenuItem Header="Cobros">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8C7;"/></MenuItem.Icon>
                    <MenuItem Header="Listar cuotas"  Click="OnMenuListarCuotas"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8F1;"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Cobrar cuota"   Click="OnMenuCobrarCuota"> <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8AB;"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="MnuAsignarCobrador" Header="Asignar cobrador..." Click="OnMenuAsignarCobranzas"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE77B;"/></MenuItem.Icon></MenuItem>
                    <MenuItem x:Name="MnuDescuentoCuota" Header="Descuento por Nota de Crédito..." Click="OnMenuDescuentoCuota" Visibility="Collapsed"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8C7;"/></MenuItem.Icon></MenuItem>
                </MenuItem>
                <MenuItem Header="Compras">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE7BF;"/></MenuItem.Icon>
                    <MenuItem Header="Crear compra"      Click="OnMenuNuevaCompra">   <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE710;"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Editar compra"     Click="OnMenuEditarCompras"> <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE70F;"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Historial Compras" Click="OnMenuHCompras">      <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE81C;"/></MenuItem.Icon></MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Generar Pagos..."          Click="OnMenuGenerarPagos">      <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8C7;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Editar Pagos..."           Click="OnMenuEditarPagos">       <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE70F;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Eliminar Pago generado..." Click="OnMenuEliminarPago">      <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE74D;"/></MenuItem.Icon></MenuItem>

                <MenuItem Header="Retiro libre..."           Click="OnMenuRetiroLibre">       <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8D7;"/></MenuItem.Icon></MenuItem>
                <MenuItem x:Name="MnuMultas" Header="Multas a funcionarios..." Click="OnMenuMultas" Visibility="Collapsed">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE7EF;"/></MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="Solicitudes">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8A5;"/></MenuItem.Icon>
                    <MenuItem Header="Ingresar solicitud" Click="OnMenuIngresarSolicitud"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE710;"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Visor solicitudes"  Click="OnMenuVisorSolicitudes"> <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE721;"/></MenuItem.Icon></MenuItem>
                </MenuItem>
                <MenuItem Header="Transferencias">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8AB;"/></MenuItem.Icon>
                    <MenuItem Header="Nueva transferencia"   Click="OnMenuNuevaTransferencia">  <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE710;"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Aceptar transferencia" Click="OnMenuAceptarTransferencia"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8FB;"/></MenuItem.Icon></MenuItem>
                </MenuItem>
                <MenuItem Header="Ventas">
                    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8C7;"/></MenuItem.Icon>
                    <MenuItem Header="Venta a crédito"  Click="OnMenuVentaCredito"> <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8C7;"/></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Venta al contado" Click="OnMenuVentaContado"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8D0;"/></MenuItem.Icon></MenuItem>
                </MenuItem>
            </MenuItem>

            <!-- INFORMES -->
            <MenuItem Header="Informes 2">
                <MenuItem Header="Activos..."           Click="OnMenuActivos">       <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8F1;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Atrasos..."           Click="OnMenuAtrasos">       <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE7BA;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Cobranzas..."         Click="OnMenuHCobranzas">    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8C7;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Compras..."           Click="OnMenuHCompras">      <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE7BF;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Créditos..."          Click="OnMenuHCreditos">     <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE825;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="En promoción..."      Click="OnMenuEnPromocion">   <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8EC;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Gestión de Promociones..." Click="OnMenuGestionPromo"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8B7;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="H. Nota de crédito..." Click="OnMenuHNotaCredito"> <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8A5;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Mov. Artículos..."    Click="OnMenuMovArt">        <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE7C4;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Pendientes..."        Click="OnMenuPendientes">    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE91C;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Transferencias..."    Click="OnMenuHTransferencias"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8AB;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Ventas..."            Click="OnMenuHVentas">       <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8D0;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Ver Artículos..."     Click="OnMenuVerArticulos">  <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE721;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Ver Artículos"        Click="OnMenuVerArticulosListado"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8FD;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Visor Promoción..."   Click="OnMenuVisorPromo">    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8F4;"/></MenuItem.Icon></MenuItem>
            </MenuItem>

            <!-- CAJA -->
            <MenuItem Header="Caja">
                <MenuItem Header="Apertura..."      Click="OnMenuCajaApertura"> <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE785;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Arqueo..."        Click="OnMenuCajaArqueo">   <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE9D2;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Ver gastos..."    Click="OnMenuCajaGastos">   <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8C7;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Registrar..."     Click="OnMenuCajaRegistrar"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8C4;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Cierre de caja..." Click="OnMenuCajaCierre">  <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE72E;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Historial Caja..." Click="OnMenuCajaHistorial"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE81C;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Comprobantes de Depósito..." Click="OnMenuCajaComprobantesPendientes"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8A5;"/></MenuItem.Icon></MenuItem>
            </MenuItem>

            <!-- HERRAMIENTAS -->
            <MenuItem Header="Herramientas">
                <MenuItem Header="Actualizar cajas cerradas..." Click="OnMenuActualizarCajasCerradas"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE72E;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Bloquear transferencias..."  Click="OnMenuBloquearTransf">    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE72E;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Editar cuota pagada..."      Click="OnMenuEditarCuota">       <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE70F;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Eliminar venta contado..."   Click="OnMenuEliminarVentaCont"> <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE74D;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Eliminar venta crédito..."  Click="OnMenuEliminarVentaCred"> <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE74D;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Finalizar promoción..."      Click="OnMenuFinalizarPromo">    <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE930;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Nota de crédito..."          Click="OnMenuNotaCredito">       <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8A5;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Promoción..."                Click="OnMenuPromocion">         <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8EC;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Puntorio..."                 Click="OnMenuPunitorio">         <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE713;"/></MenuItem.Icon></MenuItem>
            </MenuItem>

            <MenuItem Header="Acerca de..." Click="OnMenuAcercaDe">
                <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE946;" Foreground="White"/></MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="Gasto caja antiguo" Click="OnMenuGastoCajaAntiguo"/>

            <MenuItem Header="Impresoras y Comprobantes">
                <MenuItem Header="Impresoras..."               Click="OnMenuImpresoras">        <MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE749;"/></MenuItem.Icon></MenuItem>
                <MenuItem Header="Reimprimir Comprobantes..."  Click="OnMenuReimprimirComprobantes"><MenuItem.Icon><TextBlock Style="{StaticResource Ico}" Text="&#xE8A5;"/></MenuItem.Icon></MenuItem>
            </MenuItem>
        </Menu>

        <!-- ══ TOOLBAR FILA 1 — Maestros ══ -->
        <Border DockPanel.Dock="Top" Background="White"
                BorderBrush="#D6E4EE" BorderThickness="0,0,0,1">
            <WrapPanel Margin="6,4">
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuArticulos">
                    <StackPanel><TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Artículos" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuBancos">
                    <StackPanel><TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Bancos" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuCategorias">
                    <StackPanel><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Categorías" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuSubcategorias">
                    <StackPanel><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Subcategorías" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuClientes">
                    <StackPanel><TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Clientes" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuFuncionarios">
                    <StackPanel><TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Funcionarios" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuVisorSolicitudes">
                    <StackPanel><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Visor de Solicitudes" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuLocales">
                    <StackPanel><TextBlock Text="&#xE731;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Locales" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuMarcas">
                    <StackPanel><TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Marcas" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuSecciones">
                    <StackPanel><TextBlock Text="&#xE8B1;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Secciones" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuProcedencias">
                    <StackPanel><TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Procedencia" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuProveedores">
                    <StackPanel><TextBlock Text="&#xE83F;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Proveedores" HorizontalAlignment="Center"/></StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuMedidas">
                    <StackPanel><TextBlock Text="&#xE8EF;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" Foreground="#1A4F6E"/>
                    <TextBlock Text="Medidas" HorizontalAlignment="Center"/></StackPanel>
                </Button>
            </WrapPanel>
        </Border>

        <!-- ══ TOOLBAR FILA 2 — Acciones rápidas ══ -->
        <Border x:Name="ToolbarFila2" DockPanel.Dock="Top" Background="#EBF3F8"
                BorderBrush="#C5D9E8" BorderThickness="0,0,0,1">
            <WrapPanel Margin="6,3">
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuAtrasos">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#C0392B" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Atrasos" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuHCobranzas">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="H Cobranzas" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuHCompras">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="H Compras" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuHCreditos">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE825;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="H Créditos" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuMovArt">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7C4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Mov.Art" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnPromoDropdown">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="PromoMenu">
                            <MenuItem Header="En Promoción (listado)"  Click="OnMenuEnPromocion"/>
                            <MenuItem Header="Gestión de Promociones"  Click="OnMenuGestionPromo"/>
                            <MenuItem Header="Visor Promo (local)"     Click="OnMenuVisorPromo"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Promoción ▾" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuHTransferencias">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="H Transferencias" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuHVentas">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D0;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="H Ventas" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnVerArticulos" Style="{StaticResource ToolbarBtn}" Click="OnMenuVerArticulos">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Ver Artículos + Simulador" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuVerArticulosListado">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Ver Artículos" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuHNotaCredito">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="H N.Crédito" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnToolbarCompras">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Crear compra"      Click="OnMenuNuevaCompra"/>
                            <MenuItem Header="Editar compra"     Click="OnMenuEditarCompras"/>
                            <MenuItem Header="Historial Compras" Click="OnMenuHCompras"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BF;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Compras ▼" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnMenuVisorSolicitudes">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Solicitudes" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnToolbarVentas">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Venta a crédito"  Click="OnMenuVentaCredito"/>
                            <MenuItem Header="Venta al contado" Click="OnMenuVentaContado"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Ventas ▼" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnToolbarTransferencias">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Remitir (Nueva transferencia)" Click="OnMenuNuevaTransferencia"/>
                            <MenuItem Header="Recibir transferencia"         Click="OnMenuAceptarTransferencia"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1A4F6E" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Transferencias ▼" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Botón actualizar dashboard -->
                <Separator Style="{StaticResource ToolbarSep}"/>
                <Button Style="{StaticResource ToolbarBtn}" Click="OnRefreshDashboard" ToolTip="Actualizar dashboard">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#1F6089" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="Actualizar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- Botón actualizar versión del sistema — solo visible si hay actualización pendiente -->
                <Button x:Name="BtnActualizarVersion" Style="{StaticResource ToolbarBtn}"
                        Click="OnActualizarVersionClick" ToolTip="Hay una nueva versión disponible"
                        Visibility="Collapsed" Margin="4,0,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="#2E7D32" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Actualizar versión nueva" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Border x:Name="BadgeActualizacion" Width="9" Height="9" CornerRadius="5"
                                Background="#E53935" BorderBrush="White" BorderThickness="1.5"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="-3,-3,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#E53935" BlurRadius="8" ShadowDepth="0" Opacity="0.9"/>
                            </Border.Effect>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Border.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1.0" To="0.35" Duration="0:0:0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </Grid>
                </Button>
            </WrapPanel>
        </Border>

        <!-- ══ BARRA DE PESTAÑAS ══ pantallas "ancladas" (Ver Artículos, etc.) — igual
             comportamiento que un navegador: título + botón X propio por pestaña. Oculta
             cuando no hay ninguna pestaña abierta (no ocupa espacio de más). -->
        <Border x:Name="TabBarRoot" DockPanel.Dock="Top" Background="#D6E4EE"
                BorderBrush="#C5D9E8" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <ItemsControl x:Name="TabBarItems">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Border>

        <!-- ══ STATUS BAR ══ -->
        <StatusBar x:Name="StatusBarRoot" DockPanel.Dock="Bottom" Background="#0E2F44">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusUsuario" Foreground="White" FontSize="12"/>
            </StatusBarItem>
            <Separator Background="#1F6089" Margin="8,2"/>
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusLocal" Foreground="White" FontSize="12"/>
            </StatusBarItem>
            <Separator Background="#1F6089" Margin="8,2"/>
            <StatusBarItem>
                <TextBlock x:Name="TxtStatusModulo" Foreground="#7FB3D3" FontSize="12"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtStatusFecha" Foreground="#7FB3D3" FontSize="12"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ══ ÁREA PRINCIPAL ══ -->
        <Grid Background="#EBF3F8">
            <Grid Margin="20,14,20,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>   <!-- Saludo + logo -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>   <!-- KPIs -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>      <!-- Paneles detalle — ocupan resto -->
                </Grid.RowDefinitions>

                <!-- ── ENCABEZADO ── -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSaludo"
                                   Text="Bienvenido"
                                   FontSize="20" FontWeight="Bold" Foreground="#0E2F44"/>
                        <TextBlock x:Name="TxtSubtitulo"
                                   Text="Panel de control — Credimar S.A."
                                   FontSize="13" Foreground="#5D8BA8" Margin="0,4,0,0"/>
                        <!-- Datos del local de la sesión actual (nombre, N° y teléfono) — visible
                             siempre que haya un local en sesión, independiente de si hay caja
                             abierta o no (a diferencia del card "CAJA ABIERTA", que es sobre la
                             caja en sí, no sobre el local). -->
                        <TextBlock x:Name="TxtLocalActual"
                                   FontSize="11.5" Foreground="#5D8BA8" Margin="0,2,0,0"/>
                        <!-- Indicador de carga del dashboard — sin esto, si el servidor tarda
                             (carga/hardware limitado), la pantalla se queda con los guiones "—"
                             de los KPIs y las grillas vacías, sin ningún aviso de que sigue
                             esperando datos (bug real reportado: parecía que el sistema se
                             había quedado sin cargar nada, sin poder distinguir "cargando" de
                             "colgado"). Visible solo mientras CargarDashboardAsync() está en
                             curso. -->
                        <StackPanel x:Name="SpCargandoDashboard" Orientation="Horizontal"
                                    Margin="0,6,0,0" Visibility="Collapsed">
                            <TextBlock Text="&#x231B;" FontSize="12" Foreground="#E67E22" Margin="0,0,6,0"/>
                            <TextBlock Text="Cargando datos..." FontSize="12" FontWeight="SemiBold"
                                       Foreground="#E67E22"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Card "Caja abierta del local" — contexto rápido de quién abrió la caja
                         y cuándo, para que el cajero/vendedor no tenga dudas al facturar.
                         Oculto por completo si no hay caja abierta en el local actual. -->
                    <Border x:Name="CardCajaAbierta" Grid.Column="1"
                            Background="#E8F5EE" BorderBrush="#2E7D32" BorderThickness="1"
                            CornerRadius="8" Padding="14,8,14,8" Margin="0,0,16,0"
                            VerticalAlignment="Center" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="CAJA ABIERTA" FontSize="9.5" FontWeight="Bold"
                                       Foreground="#2E7D32"/>
                            <TextBlock x:Name="TxtCajaAbiertaLocal" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="#0E2F44" Margin="0,2,0,0"/>
                            <TextBlock x:Name="TxtCajaAbiertaDetalle" FontSize="11" Foreground="#37474F"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Logo + nombre empresa -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="44" Height="44" CornerRadius="22"
                                Background="White" Margin="0,0,10,0">
                            <Image x:Name="ImgLogoHeader" Width="36" Height="36" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Credimar S.A." FontSize="15" FontWeight="Bold" Foreground="#0E2F44"/>
                            <TextBlock Text="Electrodomésticos" FontSize="11" Foreground="#5D8BA8"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- ── KPIs ── -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- KPI Cuotas pendientes -->
                    <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CUOTAS PENDIENTES" FontSize="10" FontWeight="Bold"
                                           Foreground="#7FB3D3" Margin="0,0,0,6"/>
                                <TextBlock x:Name="KpiCuotas" Text="—"
                                           FontSize="32" FontWeight="Bold" Foreground="#0E2F44"/>
                                <TextBlock x:Name="KpiCuotasSub" Text="del local actual"
                                           FontSize="11" Foreground="#7FB3D3" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="48" Height="48" CornerRadius="24"
                                    Background="#EBF3F8" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="#1A4F6E" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- KPI Cuotas vencidas -->
                    <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="CUOTAS VENCIDAS" FontSize="10" FontWeight="Bold"
                                           Foreground="#F1948A" Margin="0,0,0,6"/>
                                <TextBlock x:Name="KpiVencidas" Text="—"
                                           FontSize="32" FontWeight="Bold" Foreground="#C0392B"/>
                                <TextBlock x:Name="KpiVencidasSub" Text="requieren atención"
                                           FontSize="11" Foreground="#F1948A" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="48" Height="48" CornerRadius="24"
                                    Background="#FDEDEC" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="#C0392B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- KPI Solicitudes pendientes -->
                    <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SOLICITUDES A VERIFICAR" FontSize="10" FontWeight="Bold"
                                           Foreground="#F0B27A" Margin="0,0,0,6"/>
                                <TextBlock x:Name="KpiSolicitudes" Text="—"
                                           FontSize="32" FontWeight="Bold" Foreground="#E67E22"/>
                                <TextBlock x:Name="KpiSolicitudesSub" Text="pendientes de revisión"
                                           FontSize="11" Foreground="#F0B27A" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="48" Height="48" CornerRadius="24"
                                    Background="#FEF9E7" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="#E67E22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- KPI Promociones activas -->
                    <Border Grid.Column="6" Style="{StaticResource KpiCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="PROMOCIONES ACTIVAS" FontSize="10" FontWeight="Bold"
                                           Foreground="#76D7C4" Margin="0,0,0,6"/>
                                <TextBlock x:Name="KpiPromociones" Text="—"
                                           FontSize="32" FontWeight="Bold" Foreground="#148F77"/>
                                <TextBlock x:Name="KpiPromocionesSub" Text="artículos en oferta"
                                           FontSize="11" Foreground="#76D7C4" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Grid.Column="1" Width="48" Height="48" CornerRadius="24"
                                    Background="#E8F8F5" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                           Foreground="#148F77" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ── PANELES DE DETALLE ── -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Panel Solicitudes -->
                    <Border Grid.Column="0" Style="{StaticResource DashCard}">
                        <DockPanel>
                            <!-- Header -->
                            <Border DockPanel.Dock="Top" Style="{StaticResource DashHdr}"
                                    Background="#1A4F6E">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel>
                                            <TextBlock Text="SOLICITUDES DE CRÉDITO" FontSize="11"
                                                       FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="Pendientes de verificación" FontSize="10"
                                                       Foreground="#AED6F1"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Ver todas ›" Cursor="Hand"
                                            Background="Transparent" Foreground="#4FC3F7"
                                            BorderThickness="0" FontSize="11" FontWeight="SemiBold"
                                            Click="OnMenuVisorSolicitudes"/>
                                </Grid>
                            </Border>

                            <!-- Buscador + filtro de fecha + estado -->
                            <Border DockPanel.Dock="Top" Background="#EEF4FB" Padding="8,5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="90"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Placeholder via DataTrigger cuando está vacío -->
                                    <Grid Grid.Column="0" Margin="0,0,6,0">
                                        <TextBox x:Name="TxtBuscarSolicitud"
                                                 Height="26" FontSize="11"
                                                 Padding="6,0" VerticalContentAlignment="Center"
                                                 BorderBrush="#BBDEFB" BorderThickness="1"
                                                 Background="White" Foreground="#222"
                                                 TextChanged="OnBuscarSolicitudChanged"/>
                                        <TextBlock Text="Buscar nº, cliente o local..."
                                                   FontSize="11" Foreground="#A0A0A0"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtBuscarSolicitud}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="1" Width="26" Height="26" Margin="0,0,6,0"
                                            Background="#1A4F6E" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Limpiar búsqueda" Click="OnLimpiarBuscarSolicitud">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Grid.Column="2" Text="Desde:" FontSize="10.5" Foreground="#5A7D94"
                                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <DatePicker x:Name="DpSolicitudDesde" Grid.Column="3"
                                                Height="26" FontSize="10.5"
                                                SelectedDateChanged="OnFiltroFechaSolicitudChanged"
                                                ToolTip="Mostrar solicitudes desde esta fecha"/>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                                        <TextBlock Text="Estado:" FontSize="10.5" Foreground="#5A7D94"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <ComboBox x:Name="CboSolicitudEstado" Width="110" Height="24" FontSize="10.5"
                                                  SelectionChanged="OnFiltroEstadoSolicitudChanged">
                                            <!-- Default "Todos" (antes "Verificar") — varias sucursales reportaron
                                                 solicitudes que quedaban "invisibles" en el dashboard porque el
                                                 filtro arrancaba en "Verificar" y ellas ya estaban Aceptadas o
                                                 Rechazadas, sin que el cajero supiera que había que cambiar el
                                                 combo para verlas. -->
                                            <ComboBoxItem Content="Todos"      Tag="Todos"      IsSelected="True"/>
                                            <ComboBoxItem Content="Verificar"  Tag="Verificar"/>
                                            <ComboBoxItem Content="Aceptado"   Tag="Aceptado"/>
                                            <ComboBoxItem Content="Rechazado"  Tag="Rechazado"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Lista solicitudes con scroll interno -->
                            <ListView x:Name="LstSolicitudes" BorderThickness="0"
                                      Background="Transparent" FontSize="12"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      MouseDoubleClick="OnLstSolicitudesDoubleClick"
                                      SizeChanged="OnLstSolicitudesSizeChanged">
                                <ListView.Resources>
                                    <!-- Mismo ajuste que LstCuotas/LstPromociones: el estilo Material Design
                                         por defecto de GridViewColumnHeader reserva demasiado espacio para el
                                         gripper de redimensión y trunca el texto en columnas angostas. -->
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#EAF0F6"/>
                                        <Setter Property="Foreground" Value="#154360"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="6,5,4,5"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#D6E4EE"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GridViewColumnHeader">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Nro Solicitud" Width="110"
                                                        DisplayMemberBinding="{Binding Numero}"/>
                                        <GridViewColumn Header="Local"          Width="90"
                                                        DisplayMemberBinding="{Binding LocalNombre}"/>
                                        <GridViewColumn Header="Fecha"          Width="78"
                                                        DisplayMemberBinding="{Binding FechaStr}"/>
                                        <GridViewColumn x:Name="ColSolicitudCliente" Header="Cliente" Width="160"
                                                        DisplayMemberBinding="{Binding ClienteNombre}"/>
                                        <GridViewColumn Header="Vendedor"      Width="120"
                                                        DisplayMemberBinding="{Binding VendedorNombre}"/>
                                        <GridViewColumn Header="Estado"         Width="78"
                                                        DisplayMemberBinding="{Binding Estado}"/>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="2,4"/>
                                        <Setter Property="BorderBrush" Value="#EBF3F8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EBF3F8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <!-- Panel Cuotas por vencer -->
                    <Border Grid.Column="2" Style="{StaticResource DashCard}">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Style="{StaticResource DashHdr}"
                                    Background="#154360">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel>
                                            <TextBlock Text="CUOTAS PRÓXIMAS" FontSize="11"
                                                       FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="Vencen en los próximos 7 días" FontSize="10"
                                                       Foreground="#AED6F1"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Ver cobros ›" Cursor="Hand"
                                            Background="Transparent" Foreground="#4FC3F7"
                                            BorderThickness="0" FontSize="11" FontWeight="SemiBold"
                                            Click="OnMenuListarCuotas"/>
                                </Grid>
                            </Border>

                            <!-- Buscador + filtro de fecha (Desde/Hasta sobre el vencimiento) -->
                            <Border DockPanel.Dock="Top" Background="#EAF0F6" Padding="8,5">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0" Margin="0,0,0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Margin="0,0,6,0">
                                            <TextBox x:Name="TxtBuscarCuota"
                                                     Height="26" FontSize="11"
                                                     Padding="6,0" VerticalContentAlignment="Center"
                                                     BorderBrush="#BBDEFB" BorderThickness="1"
                                                     Background="White" Foreground="#222"
                                                     TextChanged="OnBuscarCuotaChanged"/>
                                            <TextBlock Text="Buscar cliente..."
                                                       FontSize="11" Foreground="#A0A0A0"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center" Margin="8,0,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TxtBuscarCuota}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <Button Grid.Column="1" Width="26" Height="26"
                                                Background="#154360" BorderThickness="0" Cursor="Hand"
                                                ToolTip="Limpiar búsqueda" Click="OnLimpiarBuscarCuota">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="11" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="Desde:" FontSize="10.5" Foreground="#5A7D94"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <DatePicker x:Name="DpCuotaDesde"
                                                    Width="98" Height="24" FontSize="10.5"
                                                    SelectedDateChanged="OnFiltroFechaCuotaChanged"
                                                    ToolTip="Vencimiento desde esta fecha"/>
                                        <TextBlock Text="Hasta:" FontSize="10.5" Foreground="#5A7D94"
                                                   VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <DatePicker x:Name="DpCuotaHasta"
                                                    Width="98" Height="24" FontSize="10.5"
                                                    SelectedDateChanged="OnFiltroFechaCuotaChanged"
                                                    ToolTip="Vencimiento hasta esta fecha"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <TextBlock Text="Atraso (días):" FontSize="10.5" Foreground="#5A7D94"
                                                   VerticalAlignment="Center" Margin="0,0,4,0"/>
                                        <TextBox x:Name="TxtAtrasoMin" Width="46" Height="24" FontSize="10.5"
                                                 Padding="4,0" VerticalContentAlignment="Center"
                                                 BorderBrush="#BBDEFB" BorderThickness="1"
                                                 Background="White" Foreground="#222"
                                                 ToolTip="Mínimo de días de atraso"
                                                 PreviewTextInput="OnSoloDigitosAtrasoCuota"
                                                 TextChanged="OnFiltroAtrasoCuotaChanged"/>
                                        <TextBlock Text="a" FontSize="10.5" Foreground="#5A7D94"
                                                   VerticalAlignment="Center" Margin="4,0,4,0"/>
                                        <TextBox x:Name="TxtAtrasoMax" Width="46" Height="24" FontSize="10.5"
                                                 Padding="4,0" VerticalContentAlignment="Center"
                                                 BorderBrush="#BBDEFB" BorderThickness="1"
                                                 Background="White" Foreground="#222"
                                                 ToolTip="Máximo de días de atraso"
                                                 PreviewTextInput="OnSoloDigitosAtrasoCuota"
                                                 TextChanged="OnFiltroAtrasoCuotaChanged"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ListView x:Name="LstCuotas" BorderThickness="0"
                                      Background="Transparent" FontSize="12"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      MouseDoubleClick="OnLstCuotasDoubleClick"
                                      SizeChanged="OnLstCuotasSizeChanged">
                                <ListView.Resources>
                                    <!-- El estilo Material Design por defecto de GridViewColumnHeader reserva
                                         demasiado espacio para el gripper de redimensión y trunca el texto en
                                         columnas angostas (N°, Atr.) — se fuerza un estilo simple y compacto. -->
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#F1F6FA"/>
                                        <Setter Property="Foreground" Value="#37474F"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="6,5,4,5"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#D6E4EE"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GridViewColumnHeader">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn x:Name="ColCuotaCliente" Header="Cliente" Width="200"
                                                        DisplayMemberBinding="{Binding ClienteNombre}"/>
                                        <GridViewColumn Header="N°"      Width="32"
                                                        DisplayMemberBinding="{Binding NCuota}"/>
                                        <GridViewColumn Header="Vto"     Width="68"
                                                        DisplayMemberBinding="{Binding VtoStr}"/>
                                        <GridViewColumn Header="Monto"   Width="82"
                                                        DisplayMemberBinding="{Binding MontoStr}"/>
                                        <GridViewColumn Header="Atr."    Width="42"
                                                        DisplayMemberBinding="{Binding DiasAtraso}"/>
                                        <GridViewColumn Header="Estado"  Width="58"
                                                        DisplayMemberBinding="{Binding EstadoTextoCorto}"/>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="2,4"/>
                                        <Setter Property="BorderBrush" Value="#EBF3F8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EBF3F8"/>
                                            </Trigger>
                                            <DataTrigger Binding="{Binding EstaVencida}" Value="True">
                                                <Setter Property="Foreground" Value="#C0392B"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </DockPanel>
                    </Border>

                    <!-- Panel Promociones -->
                    <Border Grid.Column="4" Style="{StaticResource DashCard}">
                        <DockPanel>
                            <!-- Header -->
                            <Border DockPanel.Dock="Top" Style="{StaticResource DashHdr}"
                                    Background="#0E6655">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="15" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <StackPanel>
                                            <TextBlock Text="ARTÍCULOS EN PROMOCIÓN" FontSize="11"
                                                       FontWeight="Bold" Foreground="White"/>
                                            <TextBlock x:Name="TxtPromoSubtitulo" Text="Todas las activas"
                                                       FontSize="10" Foreground="#A9DFBF"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Ver todas ›" Cursor="Hand"
                                            Background="Transparent" Foreground="#A9DFBF"
                                            BorderThickness="0" FontSize="11" FontWeight="SemiBold"
                                            Click="OnMenuEnPromocion"/>
                                </Grid>
                            </Border>

                            <!-- Buscador -->
                            <Border DockPanel.Dock="Top" Background="#F0FAF7" Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Placeholder via VisualBrush cuando está vacío -->
                                    <Grid Grid.Column="0">
                                        <TextBox x:Name="TxtBuscarPromo"
                                                 Height="26" FontSize="11"
                                                 Padding="6,0" VerticalContentAlignment="Center"
                                                 BorderBrush="#B2DFDB" BorderThickness="1"
                                                 Background="White" Foreground="#222"
                                                 TextChanged="OnBuscarPromoChanged"/>
                                        <TextBlock x:Name="TxtBuscarPromoHint"
                                                   Text="Buscar artículo, código o local..."
                                                   FontSize="11" Foreground="#A0A0A0"
                                                   IsHitTestVisible="False"
                                                   VerticalAlignment="Center" Margin="8,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=TxtBuscarPromo}" Value="">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="1" Width="26" Height="26" Margin="4,0,0,0"
                                            Background="#0E6655" BorderThickness="0" Cursor="Hand"
                                            ToolTip="Limpiar búsqueda" Click="OnLimpiarBuscarPromo">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="11" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Contador de resultados -->
                            <Border DockPanel.Dock="Top" Background="#E8F8F5" Padding="8,2">
                                <TextBlock x:Name="TxtPromoContador" Text=""
                                           FontSize="10" Foreground="#0E6655" FontWeight="SemiBold"/>
                            </Border>

                            <!-- Lista -->
                            <ListView x:Name="LstPromociones" BorderThickness="0"
                                      Background="Transparent" FontSize="12"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      SizeChanged="OnLstPromocionesSizeChanged">
                                <ListView.Resources>
                                    <!-- Mismo ajuste que LstCuotas: el estilo Material Design por defecto de
                                         GridViewColumnHeader reserva demasiado espacio para el gripper de
                                         redimensión y trunca el texto en columnas angostas. -->
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="#EAF8F1"/>
                                        <Setter Property="Foreground" Value="#0E6655"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Setter Property="Padding" Value="6,5,4,5"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#D0EEDE"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GridViewColumnHeader">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListView.Resources>
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Header="Local"    Width="82"
                                                        DisplayMemberBinding="{Binding Local}"/>
                                        <GridViewColumn Header="Código"   Width="60"
                                                        DisplayMemberBinding="{Binding Codigo}"/>
                                        <GridViewColumn x:Name="ColPromoArticulo" Header="Artículo" Width="145"
                                                        DisplayMemberBinding="{Binding Descripcion}"/>
                                        <GridViewColumn Header="P.Promo"  Width="72"
                                                        DisplayMemberBinding="{Binding PrecioStr}"/>
                                        <GridViewColumn Header="Desde"    Width="65"
                                                        DisplayMemberBinding="{Binding InicioStr}"/>
                                        <GridViewColumn Header="Hasta"    Width="65"
                                                        DisplayMemberBinding="{Binding FinStr}"/>
                                    </GridView>
                                </ListView.View>
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="2,4"/>
                                        <Setter Property="BorderBrush" Value="#E8F8F5"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#E8F8F5"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </DockPanel>
                    </Border>

                </Grid>
            </Grid>
        </Grid>

    </DockPanel>
</Window>
