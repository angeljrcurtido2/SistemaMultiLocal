<Window x:Class="CrediSoft.UI.Views.Pagos.EditarPagoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modificar pago de salarios y comisiones — ElectroMar"
        Width="960" Height="740"
        MinWidth="860" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#F0F2F5"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>
        <Style x:Key="BtnOrange" TargetType="Button">
            <Setter Property="Background"      Value="#E65100"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#BF360C"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD"/>
                    <Setter Property="Foreground" Value="#757575"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnGreen" TargetType="Button">
            <Setter Property="Background"      Value="#2E7D32"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1B5E20"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BDBDBD"/>
                    <Setter Property="Foreground" Value="#757575"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="BtnGray" TargetType="Button">
            <Setter Property="Background"      Value="#ECEFF1"/>
            <Setter Property="Foreground"      Value="#37474F"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#B0BEC5"/>
            <Setter Property="Padding"         Value="14,7"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CFD8DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="#78909C"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
        <Style x:Key="Val" TargetType="TextBox">
            <Setter Property="Padding"         Value="5,4"/>
            <Setter Property="BorderBrush"     Value="#CFD8DC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background"      Value="White"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="TextAlignment"   Value="Right"/>
        </Style>
        <Style x:Key="ValRO" TargetType="TextBox" BasedOn="{StaticResource Val}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#ECEFF1"/>
            <Setter Property="Foreground" Value="#37474F"/>
        </Style>
    </Window.Resources>

    <DockPanel>

        <!-- ══ HEADER ══ -->
        <Border DockPanel.Dock="Top" Background="#37474F" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                               Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="MODIFICAR PAGO DE SALARIOS"
                                   FontSize="15" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Buscá el funcionario, seleccioná el registro y editá los valores"
                                   FontSize="11" Foreground="#B0BEC5"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✕  Cerrar" Style="{StaticResource BtnGray}"
                        Padding="12,6" Click="OnCerrar"/>
            </Grid>
        </Border>

        <!-- ══ PANEL BÚSQUEDA ══ -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="C.I. Func.:" FontWeight="SemiBold"
                           Foreground="#37474F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtCi" Grid.Column="1" Padding="6,5"
                         BorderBrush="#CFD8DC" BorderThickness="1" FontSize="13"
                         KeyDown="OnCiKeyDown"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="6,0,0,0">
                    <Button Content="Buscar" Style="{StaticResource BtnOrange}"
                            Margin="0,0,4,0" Click="OnBuscar"/>
                    <Button Style="{StaticResource BtnGray}" Padding="10,7"
                            ToolTip="Seleccionar funcionario de la lista" Click="OnListar">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock Text="Lista" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Período -->
                <TextBlock Grid.Column="7" Text="Período:" FontWeight="SemiBold"
                           Foreground="#37474F" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <DatePicker x:Name="DpDesde" Grid.Column="8" Width="120" Margin="0,0,4,0"
                            FontSize="13" SelectedDateChanged="OnFiltroChanged"/>
                <TextBlock Grid.Column="9" Text="al" Foreground="#37474F"
                           VerticalAlignment="Center" Margin="4,0,4,0"/>
                <DatePicker x:Name="DpHasta" Grid.Column="10" Width="120"
                            FontSize="13" SelectedDateChanged="OnFiltroChanged"/>
            </Grid>
        </Border>

        <!-- ══ HISTORIAL (grilla superior) ══ -->
        <Border DockPanel.Dock="Top" Height="160" Margin="12,10,12,0"
                BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Background="White">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#37474F" Padding="10,6" CornerRadius="4,4,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HISTORIAL DE PAGOS — clic en un registro para editar"
                                   FontWeight="Bold" Foreground="White" FontSize="11"/>
                        <TextBlock x:Name="TxtContadorHistorial" Grid.Column="1"
                                   Foreground="#B0BEC5" FontSize="11"/>
                    </Grid>
                </Border>
                <DataGrid x:Name="GridHistorial"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          BorderThickness="0"
                          RowBackground="White"
                          AlternatingRowBackground="#FAFAFA"
                          HeadersVisibility="Column"
                          CanUserResizeRows="False"
                          SelectionChanged="OnHistorialSeleccionado"
                          FontSize="12">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"      Color="#1565C0"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}"  Color="White"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}"     Color="#90CAF9"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1A237E"/>
                    </DataGrid.Resources>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#E3F2FD"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"   Value="#ECEFF1"/>
                            <Setter Property="Foreground"   Value="#455A64"/>
                            <Setter Property="FontWeight"   Value="SemiBold"/>
                            <Setter Property="Padding"      Value="8,5"/>
                            <Setter Property="BorderBrush"  Value="#CFD8DC"/>
                            <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID"       Binding="{Binding IdHpf}"       Width="50"/>
                        <DataGridTextColumn Header="Fecha"    Binding="{Binding FechaFmt}"     Width="90"/>
                        <DataGridTextColumn Header="Salario"  Binding="{Binding SalarioFmt}"   Width="110" ElementStyle="{StaticResource {x:Type TextBlock}}"/>
                        <DataGridTextColumn Header="T. Ingresos" Binding="{Binding IngresosFmt}" Width="110"/>
                        <DataGridTextColumn Header="T. Descuentos" Binding="{Binding EgresosFmt}" Width="110"/>
                        <DataGridTextColumn Header="Neto"     Binding="{Binding NetoFmt}"      Width="110"/>
                        <DataGridTextColumn Header="Registrado por" Binding="{Binding Nombre}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <!-- ══ PIE ══ -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="NETO A PAGAR Gs." Style="{StaticResource Lbl}"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                    <TextBox x:Name="TxtNeto" IsReadOnly="True" Width="140"
                             Padding="6,5" FontSize="15" FontWeight="Bold"
                             TextAlignment="Right" BorderBrush="#A5D6A7"
                             BorderThickness="2" Foreground="#2E7D32" Background="#F1F8E9"/>
                </StackPanel>
                <Button x:Name="BtnGuardar" Grid.Column="1"
                        Style="{StaticResource BtnGreen}" IsEnabled="False"
                        Click="OnGuardar">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Guardar cambios  (F5)" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="3" Content="Cerrar" Style="{StaticResource BtnGray}"
                        Click="OnCerrar"/>
            </Grid>
        </Border>

        <!-- ══ FORMULARIO DE EDICIÓN ══ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <Grid Margin="12,0,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ── ASIGNACIONES ── -->
                <Border Grid.Column="0" Background="White" BorderBrush="#E0E0E0"
                        BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <Border Background="#1565C0" Padding="10,7" CornerRadius="4,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="A S I G N A C I O N E S" FontWeight="Bold"
                                           Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="%" Foreground="#90CAF9"
                                           FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="SUBTOTAL" Foreground="#90CAF9"
                                           FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Grid Margin="10,8,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Salario fijo" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSalario" Grid.Row="0" Grid.Column="2"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Venta" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPorcVenta" Grid.Row="2" Grid.Column="1"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>
                            <TextBox x:Name="TxtTotalVenta" Grid.Row="2" Grid.Column="2"
                                     Style="{StaticResource ValRO}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Cobranza" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPorcCobranza" Grid.Row="4" Grid.Column="1"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>
                            <TextBox x:Name="TxtTotalCobranza" Grid.Row="4" Grid.Column="2"
                                     Style="{StaticResource ValRO}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Plus" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtPlus" Grid.Row="6" Grid.Column="2"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Horas extras" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtHorasExtras" Grid.Row="8" Grid.Column="2"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Bonificación" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtBonificacion" Grid.Row="10" Grid.Column="2"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="Otras comisiones" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtOtrasComisiones" Grid.Row="12" Grid.Column="2"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>
                        </Grid>

                        <Border Background="#E3F2FD" Margin="10,10,10,10" Padding="10,8" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOTAL INGRESOS Gs." FontWeight="Bold"
                                           Foreground="#1565C0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtTotalIngresos" Grid.Column="1"
                                         Style="{StaticResource ValRO}"
                                         FontWeight="Bold" Foreground="#1565C0" FontSize="14"
                                         Background="#E3F2FD" BorderThickness="0"/>
                            </Grid>
                        </Border>

                        <Grid Margin="10,0,10,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="NOTA ASIGNACIÓN"/>
                                <TextBlock x:Name="TxtContadorAsig" Grid.Column="1"
                                           Style="{StaticResource Lbl}" Text="0 / 150"/>
                            </Grid>
                            <TextBox x:Name="TxtNotaAsignacion" Grid.Row="1"
                                     Padding="5,4" FontSize="12" Height="44"
                                     BorderBrush="#CFD8DC" BorderThickness="1" MaxLength="150"
                                     TextWrapping="Wrap" TextChanged="OnNotaAsigChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── DESCUENTOS ── -->
                <Border Grid.Column="2" Background="White" BorderBrush="#E0E0E0"
                        BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <Border Background="#B71C1C" Padding="10,7" CornerRadius="4,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="D E S C U E N T O S" FontWeight="Bold"
                                           Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="%" Foreground="#FFCDD2"
                                           FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="SUBTOTAL" Foreground="#FFCDD2"
                                           FontSize="11" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Grid Margin="10,8,10,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="8"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ausencias" VerticalAlignment="Center"/>
                                <TextBlock Text="  ●" Foreground="#E65100" FontSize="8" VerticalAlignment="Center"
                                           ToolTip="Valor del registro original"/>
                            </StackPanel>
                            <TextBox x:Name="TxtAusencias" Grid.Row="0" Grid.Column="2"
                                     Style="{StaticResource ValRO}" TextChanged="OnCampoChanged"/>

                            <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Adelantos" VerticalAlignment="Center"/>
                                <TextBlock Text="  ●" Foreground="#E65100" FontSize="8" VerticalAlignment="Center"
                                           ToolTip="Valor del registro original"/>
                            </StackPanel>
                            <TextBox x:Name="TxtAdelantos" Grid.Row="2" Grid.Column="2"
                                     Style="{StaticResource ValRO}" TextChanged="OnCampoChanged"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="IPS" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtIps" Grid.Row="4" Grid.Column="2"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="Cuota/s" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtCuotas" Grid.Row="6" Grid.Column="2"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>

                            <TextBlock Grid.Row="8" Grid.Column="0" Text="Multas" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtMultas" Grid.Row="8" Grid.Column="2"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>

                            <TextBlock Grid.Row="10" Grid.Column="0" Text="Otros" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtOtros" Grid.Row="10" Grid.Column="2"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>

                            <TextBlock Grid.Row="12" Grid.Column="0" Text="X" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtEquis" Grid.Row="12" Grid.Column="2"
                                     Style="{StaticResource Val}" TextChanged="OnCampoChanged"/>
                        </Grid>

                        <Border Background="#FFEBEE" Margin="10,10,10,10" Padding="10,8" CornerRadius="3">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="TOTAL DESCUENTOS Gs." FontWeight="Bold"
                                           Foreground="#B71C1C" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtTotalEgresos" Grid.Column="1"
                                         Style="{StaticResource ValRO}"
                                         FontWeight="Bold" Foreground="#B71C1C" FontSize="14"
                                         Background="#FFEBEE" BorderThickness="0"/>
                            </Grid>
                        </Border>

                        <Grid Margin="10,0,10,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Lbl}" Text="NOTA DESCUENTOS"/>
                                <TextBlock x:Name="TxtContadorEgreso" Grid.Column="1"
                                           Style="{StaticResource Lbl}" Text="0 / 150"/>
                            </Grid>
                            <TextBox x:Name="TxtNotaEgreso" Grid.Row="1"
                                     Padding="5,4" FontSize="12" Height="44"
                                     BorderBrush="#CFD8DC" BorderThickness="1" MaxLength="150"
                                     TextWrapping="Wrap" TextChanged="OnNotaEgresoChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>

            </Grid>
        </ScrollViewer>

    </DockPanel>
</Window>
