<Window x:Class="CrediSoft.UI.Views.Pagos.PagosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pago de Salarios y Comisiones — ElectroMar"
        Width="980" Height="700"
        MinWidth="900" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="#EEF4FB"
        FontFamily="Segoe UI" FontSize="13">

    <Window.Resources>

        <!-- Botón azul primario -->
        <Style x:Key="BtnPrimario" TargetType="Button">
            <Setter Property="Background"      Value="#1565C0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="16,9"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0D47A1"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B0BEC5"/>
                    <Setter Property="Foreground" Value="#ECEFF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón gris secundario -->
        <Style x:Key="BtnSecundario" TargetType="Button">
            <Setter Property="Background"      Value="#ECEFF1"/>
            <Setter Property="Foreground"      Value="#37474F"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush"     Value="#B0BEC5"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#CFD8DC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botón azul claro para acciones secundarias importantes -->
        <Style x:Key="BtnAccion" TargetType="Button">
            <Setter Property="Background"      Value="#1E88E5"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="14,8"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1565C0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#B0BEC5"/>
                    <Setter Property="Foreground" Value="#ECEFF1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Etiqueta pequeña de campo -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="Foreground" Value="#78909C"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Input editable -->
        <Style x:Key="Val" TargetType="TextBox">
            <Setter Property="Padding"                  Value="7,5"/>
            <Setter Property="BorderBrush"              Value="#BBDEFB"/>
            <Setter Property="BorderThickness"          Value="1"/>
            <Setter Property="Background"               Value="White"/>
            <Setter Property="Foreground"               Value="#212121"/>
            <Setter Property="FontSize"                 Value="13"/>
            <Setter Property="TextAlignment"            Value="Right"/>
            <Setter Property="Height"                   Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#1565C0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Input solo lectura (calculado) -->
        <Style x:Key="ValRO" TargetType="TextBox" BasedOn="{StaticResource Val}">
            <Setter Property="IsReadOnly"  Value="True"/>
            <Setter Property="Background"  Value="#F0F6FF"/>
            <Setter Property="Foreground"  Value="#37474F"/>
            <Setter Property="BorderBrush" Value="#BBDEFB"/>
        </Style>

        <!-- Input porcentaje -->
        <Style x:Key="ValPorc" TargetType="TextBox" BasedOn="{StaticResource Val}">
            <Setter Property="Background"  Value="#FFF8E1"/>
            <Setter Property="BorderBrush" Value="#FFD54F"/>
            <Setter Property="Foreground"  Value="#E65100"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
        </Style>

    </Window.Resources>

    <DockPanel>

        <!-- ══ HEADER ══ -->
        <Border DockPanel.Dock="Top" Background="#0E2F44" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="22"
                        Background="#1565C0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="&#xE8C7;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="PAGO DE SALARIOS Y COMISIONES"
                               FontSize="15" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Registrá el pago de un funcionario y volcalo en caja"
                               FontSize="11" Foreground="#90CAF9" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource BtnSecundario}"
                        Padding="14,8" Click="OnCerrar" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="Cerrar" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ══ BARRA: FUNCIONARIO + LOCAL + PERÍODO ══ -->
        <Border DockPanel.Dock="Top" Background="White"
                BorderBrush="#BBDEFB" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- btn funcionario -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>  <!-- local label + btn -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>  <!-- período -->
                </Grid.ColumnDefinitions>

                <!-- Seleccionar funcionario -->
                <Button x:Name="BtnListarFuncionarios" Grid.Column="0"
                        Style="{StaticResource BtnAccion}"
                        Height="38" Padding="16,0"
                        ToolTip="Seleccionar funcionario de la lista"
                        Click="OnListarFuncionarios">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                        <TextBlock Text="Seleccionar funcionario" VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Button>

                <!-- Local: caja real desde donde saldrá el pago. Botón en azul (no gris, que se
                     confundía visualmente con "Cerrar"/"Cancelar" y pasaba desapercibido como
                     no-clickeable) — es la forma de pagar desde un local distinto al de base
                     del funcionario si, por ejemplo, vendió como externo en otra sucursal y esa
                     caja es la que está abierta. Solo un ADMINISTRADOR (o el usuario con
                     excepción puntual, ver Usuario.PuedeVerTodosLosLocales) puede cambiarlo — un
                     usuario normal ve el local de SU sesión como texto fijo, sin botón, porque
                     el efectivo del pago sale de su propia caja (ver CargarLocales en el code-
                     behind, que oculta BtnSeleccionarLocal/TxtAyudaLocal según el permiso). -->
                <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="LOCAL DE PAGO:" FontWeight="SemiBold" Foreground="#37474F"
                                   VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                        <Button x:Name="BtnSeleccionarLocal" Style="{StaticResource BtnAccion}"
                                Height="34" MinWidth="190" Padding="10,0"
                                Click="OnSeleccionarLocal"
                                ToolTip="Cambiar el local desde el que se paga (y de cuya caja sale el efectivo)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="TxtLocalSeleccionado"
                                           Text="Seleccionar local..."
                                           VerticalAlignment="Center" FontSize="12"/>
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="9" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <!-- Reemplaza al botón cuando el usuario no puede cambiar de local: mismo
                             texto del local (TxtLocalFijo se sincroniza con TxtLocalSeleccionado
                             en SetLocalSeleccionado), pero sin apariencia de control clickeable. -->
                        <TextBlock x:Name="TxtLocalFijo" Visibility="Collapsed" FontSize="12"
                                   FontWeight="SemiBold" Foreground="#0E2F44"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtAyudaLocal" Text="Tocá para cambiar de local"
                               FontSize="9" Foreground="#78909C" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Período -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Período:" FontWeight="SemiBold" Foreground="#37474F"
                               VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12"/>
                    <DatePicker x:Name="DpDesde" Width="120" Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                SelectedDateChanged="OnPeriodoChanged"/>
                    <TextBlock Text="al" Foreground="#78909C"
                               VerticalAlignment="Center" Margin="0,0,6,0" FontSize="12"/>
                    <DatePicker x:Name="DpHasta" Width="120"
                                VerticalAlignment="Center"
                                SelectedDateChanged="OnPeriodoChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ PANEL FUNCIONARIO SELECCIONADO (visible tras seleccionar) ══ -->
        <Border x:Name="PanelFuncionario" DockPanel.Dock="Top"
                Visibility="Collapsed" Background="#F5F9FF"
                BorderBrush="#BBDEFB" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource Lbl}" Text="FUNCIONARIO SELECCIONADO"/>
                    <TextBlock x:Name="TxtNombre" FontWeight="Bold"
                               Foreground="#0E2F44" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Lbl}" Text="LOCAL"/>
                    <TextBlock x:Name="TxtLocal" FontWeight="SemiBold"
                               Foreground="#1565C0" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Style="{StaticResource Lbl}" Text="SALARIO BASE Gs."/>
                    <TextBlock x:Name="TxtSalarioBase" FontWeight="SemiBold"
                               Foreground="#37474F" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Style="{StaticResource Lbl}" Text="% COMISIÓN VENTA / COBR."/>
                    <TextBlock x:Name="TxtPorcs" FontWeight="SemiBold"
                               Foreground="#37474F" FontSize="12"/>
                </StackPanel>

                <Border x:Name="AlertaLocal" Grid.Column="4" Visibility="Collapsed"
                        Background="#FFF3E0" BorderBrush="#FFB300" BorderThickness="1"
                        CornerRadius="4" Padding="10,6" Margin="12,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="#E65100" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <StackPanel>
                            <TextBlock Text="LOCAL DIFERENTE" FontSize="9"
                                       FontWeight="Bold" Foreground="#E65100"/>
                            <TextBlock x:Name="TxtAlertaLocal" FontSize="10" Foreground="#BF360C"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ══ PIE: MÉTODO + NETO + BOTONES ══ -->
        <Border DockPanel.Dock="Bottom" Background="White"
                BorderBrush="#BBDEFB" BorderThickness="0,1,0,0" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>   <!-- método -->
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="160"/>   <!-- referencia -->
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>  <!-- neto -->
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="Auto"/>  <!-- guardar -->
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>  <!-- cancelar -->
                </Grid.ColumnDefinitions>

                <!-- Método de pago -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Lbl}" Text="MÉTODO DE PAGO"/>
                    <ComboBox x:Name="CboMetodo" Padding="7,5" FontSize="12" Height="32"
                              BorderBrush="#BBDEFB" Background="White" Foreground="#212121"
                              VerticalContentAlignment="Center"
                              SelectionChanged="OnMetodoChanged">
                        <ComboBoxItem Content="EFECTIVO" IsSelected="True"/>
                        <ComboBoxItem Content="TRANSFERENCIA"/>
                        <ComboBoxItem Content="CHEQUE"/>
                    </ComboBox>
                </StackPanel>

                <!-- Referencia/Cheque -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Lbl}" Text="N° REF. / CHEQUE"/>
                    <TextBox x:Name="TxtReferencia" Padding="7,5" FontSize="12" Height="32"
                             BorderBrush="#BBDEFB" BorderThickness="1"
                             Background="White" Foreground="#212121"
                             IsEnabled="False" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Neto destacado -->
                <Border Grid.Column="4" Background="#0E2F44" CornerRadius="8"
                        Padding="16,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Text="NETO A PAGAR" FontSize="9" FontWeight="Bold"
                                       Foreground="#90CAF9"/>
                            <TextBlock Text="Gs." FontSize="11" Foreground="#BBDEFB"/>
                        </StackPanel>
                        <TextBox x:Name="TxtNeto" IsReadOnly="True"
                                 FontSize="22" FontWeight="Bold"
                                 TextAlignment="Right" Foreground="White"
                                 Background="Transparent" BorderThickness="0"
                                 VerticalContentAlignment="Center" Width="140" Text="0"/>
                    </StackPanel>
                </Border>

                <!-- Guardar -->
                <Button x:Name="BtnGuardar" Grid.Column="6"
                        Style="{StaticResource BtnPrimario}"
                        Height="40" Padding="18,0"
                        Click="OnGuardar">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Guardar pago  (F5)" VerticalAlignment="Center"
                                   FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Button>

                <!-- Cancelar -->
                <Button Grid.Column="8" Style="{StaticResource BtnSecundario}"
                        Height="40" Padding="16,0" Click="OnCerrar">
                    <TextBlock Text="Cancelar" VerticalAlignment="Center"/>
                </Button>
            </Grid>
        </Border>

        <!-- ══ CUERPO: ASIGNACIONES | DESCUENTOS ══ -->
        <Grid Margin="14,10,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── ASIGNACIONES ── -->
            <Border Grid.Column="0" Background="White"
                    BorderBrush="#BBDEFB" BorderThickness="1" CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2" Direction="270" Color="Black"/>
                </Border.Effect>
                <DockPanel>

                    <!-- Cabecera azul -->
                    <Border DockPanel.Dock="Top" Background="#1565C0"
                            Padding="14,9" CornerRadius="6,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="64"/>
                                <ColumnDefinition Width="116"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="+" Foreground="#90CAF9" FontSize="15"
                                           FontWeight="Bold" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="ASIGNACIONES" FontWeight="Bold"
                                           Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="%" Foreground="#90CAF9"
                                       FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="SUBTOTAL Gs."
                                       Foreground="#90CAF9" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        </Grid>
                    </Border>

                    <!-- Total ingresos -->
                    <Border DockPanel.Dock="Bottom" Background="#E3F2FD"
                            BorderBrush="#BBDEFB" BorderThickness="0,1,0,0" Padding="14,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="116"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TOTAL INGRESOS Gs." FontWeight="Bold"
                                       Foreground="#1565C0" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="TxtTotalIngresos" Grid.Column="1"
                                     IsReadOnly="True" FontWeight="Bold" Foreground="#1565C0"
                                     FontSize="15" TextAlignment="Right" Background="Transparent"
                                     BorderThickness="0" VerticalContentAlignment="Center" Text="0"/>
                        </Grid>
                    </Border>

                    <!-- Nota asignación -->
                    <Border DockPanel.Dock="Bottom" Padding="12,6,12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="38"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Lbl}" Text="NOTA ASIGNACIÓN"/>
                            <TextBox x:Name="TxtNotaAsignacion" Grid.Row="1"
                                     Padding="7,5" FontSize="12"
                                     BorderBrush="#BBDEFB" BorderThickness="1"
                                     Background="White" MaxLength="150"
                                     TextWrapping="Wrap" AcceptsReturn="False"
                                     TextChanged="OnNotaAsignacionChanged"/>
                        </Grid>
                    </Border>

                    <!-- Filas asignaciones — envueltas en ScrollViewer: sin esto, en pantallas
                         de 768px de alto estas 7 filas (que no tienen Dock, ocupan el espacio
                         central restante del DockPanel) se comprimían junto con el resto del
                         formulario, ya que header/total/nota SÍ están fijos con Dock.Top/Bottom.
                         El pie con "Guardar pago"/"Cancelar" sigue siempre visible porque está
                         en DockPanel.Dock="Bottom" del layout raíz (fuera de este ScrollViewer),
                         igual patrón que EditarPagoWindow.xaml/EliminarPagoWindow.xaml. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="12,6,12,0" MinHeight="230">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="64"/>
                            <ColumnDefinition Width="116"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Salario fijo"
                                   VerticalAlignment="Center" Foreground="#455A64" FontSize="12"/>
                        <TextBox x:Name="TxtSalario" Grid.Row="0" Grid.Column="2"
                                 Style="{StaticResource Val}" TextChanged="OnAsignacionChanged"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Comisión venta  🔍"
                                   VerticalAlignment="Center" Foreground="#1565C0" FontSize="12"
                                   Cursor="Hand" FontWeight="SemiBold"
                                   ToolTip="Clic para ver el detalle de ventas del período"
                                   MouseLeftButtonDown="OnVerDetalleVentas"/>
                        <TextBox x:Name="TxtPorcVenta" Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource ValPorc}" TextChanged="OnAsignacionChanged"
                                 ToolTip="Porcentaje de comisión sobre ventas del período"/>
                        <TextBox x:Name="TxtTotalVenta" Grid.Row="1" Grid.Column="2"
                                 Style="{StaticResource ValRO}"
                                 ToolTip="Calculado: % × total de entregas iniciales del período (no el precio total del producto)"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Comisión cobranza  🔍"
                                   VerticalAlignment="Center" Foreground="#1565C0" FontSize="12"
                                   Cursor="Hand" FontWeight="SemiBold"
                                   ToolTip="Clic para ver el detalle de cobranzas del período"
                                   MouseLeftButtonDown="OnVerDetalleCobranzas"/>
                        <TextBox x:Name="TxtPorcCobranza" Grid.Row="2" Grid.Column="1"
                                 Style="{StaticResource ValPorc}" TextChanged="OnAsignacionChanged"
                                 ToolTip="Porcentaje de comisión sobre cobranzas del período"/>
                        <TextBox x:Name="TxtTotalCobranza" Grid.Row="2" Grid.Column="2"
                                 Style="{StaticResource ValRO}"
                                 ToolTip="Calculado: % × total cobranzas del período"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Plus"
                                   VerticalAlignment="Center" Foreground="#455A64" FontSize="12"/>
                        <TextBox x:Name="TxtPlus" Grid.Row="3" Grid.Column="2"
                                 Style="{StaticResource Val}" TextChanged="OnAsignacionChanged"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Horas extras"
                                   VerticalAlignment="Center" Foreground="#455A64" FontSize="12"/>
                        <TextBox x:Name="TxtHorasExtras" Grid.Row="4" Grid.Column="2"
                                 Style="{StaticResource Val}" TextChanged="OnAsignacionChanged"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Bonificación"
                                   VerticalAlignment="Center" Foreground="#455A64" FontSize="12"/>
                        <TextBox x:Name="TxtBonificacion" Grid.Row="5" Grid.Column="2"
                                 Style="{StaticResource Val}" TextChanged="OnAsignacionChanged"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Otras comisiones"
                                   VerticalAlignment="Center" Foreground="#455A64" FontSize="12"/>
                        <TextBox x:Name="TxtOtrasComisiones" Grid.Row="6" Grid.Column="2"
                                 Style="{StaticResource Val}" TextChanged="OnAsignacionChanged"/>
                    </Grid>
                    </ScrollViewer>

                </DockPanel>
            </Border>

            <!-- ── DESCUENTOS ── -->
            <Border Grid.Column="2" Background="White"
                    BorderBrush="#FFCDD2" BorderThickness="1" CornerRadius="6">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" Opacity="0.06" ShadowDepth="2" Direction="270" Color="Black"/>
                </Border.Effect>
                <DockPanel>

                    <!-- Cabecera roja -->
                    <Border DockPanel.Dock="Top" Background="#C62828"
                            Padding="14,9" CornerRadius="6,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="116"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="−" Foreground="#FFCDD2" FontSize="16"
                                           FontWeight="Bold" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="DESCUENTOS" FontWeight="Bold"
                                           Foreground="White" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="SUBTOTAL Gs."
                                       Foreground="#FFCDD2" FontSize="11" FontWeight="SemiBold"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        </Grid>
                    </Border>

                    <!-- Total descuentos -->
                    <Border DockPanel.Dock="Bottom" Background="#FFEBEE"
                            BorderBrush="#FFCDD2" BorderThickness="0,1,0,0" Padding="14,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="116"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="TOTAL DESCUENTOS Gs." FontWeight="Bold"
                                       Foreground="#C62828" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox x:Name="TxtTotalEgresos" Grid.Column="1"
                                     IsReadOnly="True" FontWeight="Bold" Foreground="#C62828"
                                     FontSize="15" TextAlignment="Right" Background="Transparent"
                                     BorderThickness="0" VerticalContentAlignment="Center" Text="0"/>
                        </Grid>
                    </Border>

                    <!-- Nota descuentos -->
                    <Border DockPanel.Dock="Bottom" Padding="12,6,12,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="38"/>
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource Lbl}" Text="NOTA DESCUENTOS"/>
                            <TextBox x:Name="TxtNotaEgreso" Grid.Row="1"
                                     Padding="7,5" FontSize="12"
                                     BorderBrush="#FFCDD2" BorderThickness="1"
                                     Background="White" MaxLength="150"
                                     TextWrapping="Wrap" AcceptsReturn="False"
                                     TextChanged="OnNotaEgresoChanged"/>
                        </Grid>
                    </Border>

                    <!-- Filas descuentos — mismo motivo que "Filas asignaciones" arriba: sin
                         ScrollViewer estas 7 filas se comprimían en pantallas de 768px. -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="12,6,12,0" MinHeight="230">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="116"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ausencias (auto) -->
                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Ausencias" Foreground="#455A64"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#FFF3E0" CornerRadius="3"
                                    Padding="5,1" Margin="7,0,0,0">
                                <TextBlock Text="auto" FontSize="9" Foreground="#E65100" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBox x:Name="TxtAusencias" Grid.Row="0" Grid.Column="1"
                                 Style="{StaticResource ValRO}"
                                 ToolTip="Calculado desde MOV_FUNCIONARIOS del período"
                                 TextChanged="OnDescuentoChanged"/>

                        <!-- Adelantos (auto) -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Adelantos" Foreground="#455A64"
                                       VerticalAlignment="Center" FontSize="12"/>
                            <Border Background="#FFF3E0" CornerRadius="3"
                                    Padding="5,1" Margin="7,0,0,0">
                                <TextBlock Text="auto" FontSize="9" Foreground="#E65100" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBox x:Name="TxtAdelantos" Grid.Row="1" Grid.Column="1"
                                 Style="{StaticResource ValRO}"
                                 ToolTip="Calculado desde MOV_FUNCIONARIOS del período"
                                 TextChanged="OnDescuentoChanged"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="IPS"
                                   VerticalAlignment="Center" Foreground="#455A64" FontSize="12"/>
                        <TextBox x:Name="TxtIps" Grid.Row="2" Grid.Column="1"
                                 Style="{StaticResource Val}" TextChanged="OnDescuentoChanged"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Cuota/s"
                                   VerticalAlignment="Center" Foreground="#455A64" FontSize="12"/>
                        <TextBox x:Name="TxtCuotas" Grid.Row="3" Grid.Column="1"
                                 Style="{StaticResource Val}" TextChanged="OnDescuentoChanged"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Multas"
                                   VerticalAlignment="Center" Foreground="#455A64" FontSize="12"/>
                        <!-- Solo lectura: se autocompleta desde el módulo "Multas a funcionarios"
                             (Movimientos > Multas a funcionarios), ya no se tipea a mano. -->
                        <TextBox x:Name="TxtMultas" Grid.Row="4" Grid.Column="1"
                                 Style="{StaticResource Val}" IsReadOnly="True" Focusable="False"
                                 Background="#ECEFF1" TextChanged="OnDescuentoChanged"/>
                        <!-- Abre el módulo de Multas sin salir de Pago de Salarios — al cerrarlo
                             se recalcula el período para traer la multa recién cargada, sin que
                             el usuario tenga que volver a seleccionar el funcionario a mano. -->
                        <Button Grid.Row="4" Grid.Column="2" x:Name="BtnAgregarMulta"
                                Content="+ Agregar" Margin="6,0,0,0" Padding="8,4"
                                FontSize="11" FontWeight="SemiBold"
                                Background="#FFEBEE" Foreground="#C0281B" BorderThickness="0"
                                Cursor="Hand" Click="OnAgregarMulta"
                                ToolTip="Cargar una nueva multa sin salir de esta pantalla"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Otros"
                                   VerticalAlignment="Center" Foreground="#455A64" FontSize="12"/>
                        <TextBox x:Name="TxtOtros" Grid.Row="5" Grid.Column="1"
                                 Style="{StaticResource Val}" TextChanged="OnDescuentoChanged"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="X"
                                   VerticalAlignment="Center" Foreground="#455A64" FontSize="12"/>
                        <TextBox x:Name="TxtEquis" Grid.Row="6" Grid.Column="1"
                                 Style="{StaticResource Val}" TextChanged="OnDescuentoChanged"/>
                    </Grid>
                    </ScrollViewer>

                </DockPanel>
            </Border>

        </Grid>

    </DockPanel>
</Window>
