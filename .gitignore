# Config con datos de conexión reales — NUNCA debe llegar a un repo público.
# appsettings.Local.json / appsettings.Remote.json llevan la IP y contraseña
# real del servidor de producción de Credimar S.A. Solo el appsettings.json
# base (sin credenciales, ServidorPath en blanco) se versiona.
CrediSoft.UI/appsettings.Local.json
CrediSoft.UI/appsettings.Remote.json
**/appsettings.Local.json
**/appsettings.Remote.json

# Base de datos local SQLite/archivo de prueba, si llegara a generarse acá
CrediSoft.UI/CREDISOFT.db
*.db

